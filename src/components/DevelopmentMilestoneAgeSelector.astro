---
import { DEVELOPMENT_MILESTONES } from '../data/development-milestones';
import { localePath } from '../lib/urls';
import type { Locale } from '../site.config';

interface Props {
  locale: Locale;
  parentSlug: string;
}

const { locale, parentSlug } = Astro.props;
const copy = DEVELOPMENT_MILESTONES[locale];

const groups = copy
  ? [
      { title: 'До 1 года', ages: copy.ages.slice(0, 4) },
      { title: 'От 1 года до 2,5 лет', ages: copy.ages.slice(4, 9) },
      { title: 'От 3 до 5 лет', ages: copy.ages.slice(9) },
    ]
  : [];
---

{
  copy && (
    <section class="milestone-age-selector" aria-labelledby="milestone-age-selector-title">
      <div class="milestone-age-selector__intro">
        <p class="eyebrow">Листы наблюдений</p>
        <h2 id="milestone-age-selector-title">Выберите возраст ребёнка</h2>
        <p>Откройте возраст, который ребёнку уже исполнился.</p>
      </div>

      <div class="milestone-age-selector__groups">
        {groups.map((group) => (
          <section class="milestone-age-selector__group">
            <h3>{group.title}</h3>
            <div class="milestone-age-selector__grid">
              {group.ages.map((age) => (
                <a
                  class="milestone-age-selector__card"
                  href={localePath(locale, `parents/${parentSlug}/${age.slug}`)}
                >
                  <strong>{age.label}</strong>
                  <span>Открыть лист <span aria-hidden="true">→</span></span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="milestone-age-selector__note">
        <p><strong>Если возраст находится между двумя точками</strong>, используйте предыдущую. Например, в 20 месяцев откройте лист для 18 месяцев.</p>
        <p>Если ребёнок родился более чем на 3 недели раньше предполагаемого срока, для ранних возрастов CDC рекомендует использовать скорректированный возраст. Если вы не уверены, какой возраст учитывать, обсудите это с врачом.</p>
      </div>
    </section>
  )
}

<style>
  .milestone-age-selector {
    margin-block: 2rem 3.5rem;
    padding: clamp(1.2rem, 3vw, 1.7rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background: var(--color-surface-soft);
  }

  .milestone-age-selector__intro {
    display: grid;
    gap: 0.6rem;
  }

  .milestone-age-selector__intro h2 {
    font-size: clamp(1.55rem, 4vw, 2.15rem);
  }

  .milestone-age-selector__intro > p:last-child {
    color: var(--color-muted);
  }

  .milestone-age-selector__groups {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .milestone-age-selector__group h3 {
    margin-bottom: 0.75rem;
    font-size: 1rem;
    letter-spacing: 0;
  }

  .milestone-age-selector__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .milestone-age-selector__card {
    display: grid;
    min-height: 5.8rem;
    align-content: space-between;
    gap: 0.75rem;
    padding: 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    background: var(--color-surface);
    color: var(--color-ink);
    text-decoration: none;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .milestone-age-selector__card:hover,
  .milestone-age-selector__card:focus-visible {
    border-color: var(--color-primary);
    box-shadow: 0 0.5rem 1.4rem rgb(23 36 58 / 9%);
    color: var(--color-ink);
    transform: translateY(-0.1rem);
  }

  .milestone-age-selector__card strong {
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .milestone-age-selector__card span {
    color: var(--color-primary-dark);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .milestone-age-selector__note {
    display: grid;
    gap: 0.65rem;
    margin-top: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  @media (max-width: 42rem) {
    .milestone-age-selector__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .milestone-age-selector__card {
      min-height: 5.2rem;
    }
  }
</style>
