---
import { localePath } from '../lib/urls';
import type { Locale } from '../site.config';
import { KZ_ANNOUNCEMENTS, type AnnouncementKind, type AnnouncementAudience, type AnnouncementFormat, type AnnouncementCost } from '../data/kazakhstan-announcements';
const { locale } = Astro.props as { locale: Locale };

type Copy = {
  kicker: string; title: string; lead: string; noTitle: string; noText: string; suggest: string;
  disclaimer: string; illustration: string; organiserLabel: string; audienceLabel: string; costLabel: string;
  formatLabel: string; source: string; filterLabel: string; noResults: string;
  filters: Record<'all' | AnnouncementKind, string>;
  kinds: Record<AnnouncementKind, string>;
  audience: Record<AnnouncementAudience, string>;
  format: Record<AnnouncementFormat, string>;
  cost: Record<AnnouncementCost, string>;
};
const translations: Record<Locale, Copy> = {
  ru: {
    kicker: 'АКТУАЛЬНО В КАЗАХСТАНЕ', title: 'Афиша и объявления',
    lead: 'Ближайшие вебинары, мероприятия, обучение и другие возможности для семей и специалистов.',
    noTitle: 'Пока нет подтверждённых объявлений',
    noText: 'Мы формируем афишу. Здесь появятся только события с проверенными датами, организатором и официальной ссылкой.',
    suggest: 'Предложить мероприятие',
    disclaimer: 'Сведения приводятся по информации организаторов. Размещение не означает, что AutismHub одобряет мероприятие или услуги организатора.',
    illustration: 'Тематическое фото',
    organiserLabel: 'Организатор', audienceLabel: 'Для кого', costLabel: 'Участие',
    formatLabel: 'Формат', source: 'Страница организатора',
    filterLabel: 'Тип мероприятия', noResults: 'По этому фильтру пока нет актуальных объявлений.',
    filters: { all: 'Все', webinar: 'Вебинары', event: 'Мероприятия', course: 'Обучение', announcement: 'Объявления' },
    kinds: { webinar: 'Вебинар', event: 'Мероприятие', course: 'Обучение', announcement: 'Объявление' },
    audience: { parents: 'Родители', professionals: 'Специалисты', everyone: 'Все желающие' },
    format: { online: 'Онлайн', 'in-person': 'Очно', hybrid: 'Смешанный' },
    cost: { free: 'Бесплатно', paid: 'Платно', unknown: 'Уточняйте у организатора' },
  },
  kk: {
    kicker: 'ҚАЗАҚСТАНДАҒЫ ӨЗЕКТІ АҚПАРАТ', title: 'Іс-шаралар мен хабарландырулар',
    lead: 'Отбасылар мен мамандарға арналған алдағы вебинарлар, іс-шаралар, оқу және басқа мүмкіндіктер.',
    noTitle: 'Әзірге расталған хабарландыру жоқ',
    noText: 'Афишаны дайындап жатырмыз. Күні, ұйымдастырушысы және ресми сілтемесі тексерілген іс-шаралар ғана жарияланады.',
    suggest: 'Іс-шара ұсыну',
    disclaimer: 'Ақпарат ұйымдастырушылардың деректеріне негізделеді. Жариялау AutismHub іс-шараны немесе ұйымдастырушы қызметтерін мақұлдайды дегенді білдірмейді.',
    illustration: 'Тақырыптық фото',
    organiserLabel: 'Ұйымдастырушы', audienceLabel: 'Кімге арналған', costLabel: 'Қатысу',
    formatLabel: 'Формат', source: 'Ұйымдастырушы парақшасы',
    filterLabel: 'Іс-шара түрі', noResults: 'Бұл санатта әзірге өзекті хабарландыру жоқ.',
    filters: { all: 'Барлығы', webinar: 'Вебинарлар', event: 'Іс-шаралар', course: 'Оқу', announcement: 'Хабарландырулар' },
    kinds: { webinar: 'Вебинар', event: 'Іс-шара', course: 'Оқу', announcement: 'Хабарландыру' },
    audience: { parents: 'Ата-аналар', professionals: 'Мамандар', everyone: 'Барлығы' },
    format: { online: 'Онлайн', 'in-person': 'Офлайн', hybrid: 'Аралас' },
    cost: { free: 'Тегін', paid: 'Ақылы', unknown: 'Ұйымдастырушыдан нақтылаңыз' },
  },
  en: {
    kicker: 'HAPPENING IN KAZAKHSTAN', title: 'Events and announcements',
    lead: 'Upcoming webinars, events, learning opportunities and other notices for families and professionals.',
    noTitle: 'No confirmed announcements yet',
    noText: 'We are building the noticeboard. Only events with verified dates, organisers and official links will appear.',
    suggest: 'Suggest an event',
    disclaimer: 'Details are provided by event organisers. Listing does not imply AutismHub endorsement of an event or the organiser’s services.',
    illustration: 'Illustrative photo',
    organiserLabel: 'Organiser', audienceLabel: 'Audience', costLabel: 'Cost',
    formatLabel: 'Format', source: 'Organiser website',
    filterLabel: 'Event category', noResults: 'No current announcements in this category.',
    filters: { all: 'All', webinar: 'Webinars', event: 'Events', course: 'Learning', announcement: 'Notices' },
    kinds: { webinar: 'Webinar', event: 'Event', course: 'Learning', announcement: 'Notice' },
    audience: { parents: 'Parents', professionals: 'Professionals', everyone: 'Everyone' },
    format: { online: 'Online', 'in-person': 'In person', hybrid: 'Hybrid' },
    cost: { free: 'Free', paid: 'Paid', unknown: 'Check with organiser' },
  },
};
const t = translations[locale];
const today = new Intl.DateTimeFormat('sv-SE', {
  timeZone: 'Asia/Almaty', year: 'numeric', month: '2-digit', day: '2-digit',
}).format(new Date());
const announcements = KZ_ANNOUNCEMENTS
  .filter((a) => a.isPublished && a.sourceVerified && /^https:\/\//i.test(a.sourceUrl)
    && /^\d{4}-\d{2}-\d{2}$/.test(a.beginsOn)
    && /^\d{4}-\d{2}-\d{2}$/.test(a.expiresOn)
    && a.expiresOn >= today && ['ru', 'kk', 'en'].every((l) =>
      Boolean(a.title[l as Locale]?.trim() && a.summary[l as Locale]?.trim() && a.organiser[l as Locale]?.trim())))
  .sort((a, b) => a.beginsOn.localeCompare(b.beginsOn))
  .slice(0, 4);
const dateFormat = new Intl.DateTimeFormat(locale === 'ru' ? 'ru-KZ' : locale === 'kk' ? 'kk-KZ' : 'en-GB', {
  day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Asia/Almaty',
});
const filters: Array<'all' | AnnouncementKind> = ['all', 'webinar', 'event', 'course', 'announcement'];
---
<section id="announcements" class="home-v2__events" aria-labelledby="home-v2-events-title" data-events-board>
  <div class="container">
    <div class="home-v2__events-heading">
      <div>
        <p class="home-v2__kicker">{t.kicker}</p>
        <h2 id="home-v2-events-title">{t.title}</h2>
        <p class="home-v2__events-lead">{t.lead}</p>
      </div>
      <span class="home-v2__events-icon" aria-hidden="true">▦</span>
    </div>

    {announcements.length > 0 && (
      <div class="home-v2__event-filters" role="group" aria-label={t.filterLabel}>
        {filters.map((kind) => (
          <button type="button" class="home-v2__event-filter" data-event-filter={kind} aria-pressed={kind === 'all' ? 'true' : 'false'}>{t.filters[kind]}</button>
        ))}
      </div>
    )}

    <div class="home-v2__event-list" data-event-list hidden={announcements.length === 0}>
      {announcements.map((event) => (
        <article class="home-v2__event" data-event-kind={event.kind} data-event-expires={event.expiresOn}>
          <div class="home-v2__event-date">
            <time datetime={event.beginsOn}>{dateFormat.format(new Date(event.beginsOn + 'T12:00:00Z'))}</time>
          </div>
          <figure class:list={[
            'home-v2__event-media',
            event.imageKind === 'official-brand' && 'home-v2__event-media--brand',
            event.imageKind === 'organiser-logo' && 'home-v2__event-media--logo',
          ]}>
            <img
              src={event.imageSrc.startsWith('https://') ? event.imageSrc : import.meta.env.BASE_URL + event.imageSrc}
              alt={event.imageAlt[locale]}
              width="960"
              height="600"
              loading="lazy"
              decoding="async"
            />
            {event.imageKind === 'editorial-illustration' && <figcaption>{t.illustration}</figcaption>}
          </figure>
          <div class="home-v2__event-content">
            <p class="home-v2__event-kind">{t.kinds[event.kind]}</p>
            <h3><a href={event.sourceUrl} rel="external">{event.title[locale]}</a></h3>
            <p>{event.summary[locale]}</p>
            <dl class="home-v2__event-details">
              <div><dt>{t.organiserLabel}</dt><dd>{event.organiser[locale]}</dd></div>
              <div><dt>{t.formatLabel}</dt><dd>{t.format[event.format]}{event.city ? ' · ' + event.city[locale] : ''}</dd></div>
              <div><dt>{t.audienceLabel}</dt><dd>{t.audience[event.audience]}</dd></div>
              <div><dt>{t.costLabel}</dt><dd>{t.cost[event.cost]}</dd></div>
            </dl>
            <a href={event.sourceUrl} class="home-v2__event-source" rel="external">{t.source} <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      ))}
    </div>

    <div class="home-v2__events-empty" data-events-empty hidden={announcements.length > 0}>
      <span class="home-v2__events-empty-icon" aria-hidden="true">✧</span>
      <div><h3>{t.noTitle}</h3><p>{t.noText}</p></div>
    </div>
    <p class="home-v2__events-no-matches" data-events-no-matches hidden>{t.noResults}</p>
    <div class="home-v2__events-footer">
      <p>{t.disclaimer}</p>
      <a href={localePath(locale, 'about/contact')}>{t.suggest} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
<script>
  const board = document.querySelector<HTMLElement>('[data-events-board]');
  if (board) {
    const cards = [...board.querySelectorAll<HTMLElement>('[data-event-kind]')];
    const buttons = [...board.querySelectorAll<HTMLButtonElement>('[data-event-filter]')];
    const list = board.querySelector<HTMLElement>('[data-event-list]');
    const empty = board.querySelector<HTMLElement>('[data-events-empty]');
    const noMatches = board.querySelector<HTMLElement>('[data-events-no-matches]');
    let active = 'all';
    const refresh = () => {
      const today = new Intl.DateTimeFormat('sv-SE', {
        timeZone: 'Asia/Almaty', year: 'numeric', month: '2-digit', day: '2-digit',
      }).format(new Date());
      let current = 0, shown = 0;
      for (const card of cards) {
        const fresh = (card.dataset.eventExpires ?? '') >= today;
        if (fresh) current++;
        const visible = fresh && (active === 'all' || card.dataset.eventKind === active);
        card.hidden = !visible;
        if (visible) shown++;
      }
      if (list) list.hidden = shown === 0;
      if (empty) empty.hidden = current > 0;
      if (noMatches) noMatches.hidden = current === 0 || shown > 0;
      for (const button of buttons) {
        button.hidden = current === 0;
        button.setAttribute('aria-pressed', String(button.dataset.eventFilter === active));
      }
    };
    for (const button of buttons) {
      button.addEventListener('click', () => { active = button.dataset.eventFilter ?? 'all'; refresh(); });
    }
    refresh();
    document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
  }
</script>
