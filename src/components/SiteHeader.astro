---
import { UI } from '../i18n/ui';
import { localePath, sectionPath, sitePath } from '../lib/urls';
import { SECTIONS, SITE, type Locale, type Section } from '../site.config';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale?: Locale;
  currentSection?: Section;
  alternatePath?: string;
  alternatePaths?: Partial<Record<Locale, string>>;
}

const { locale, currentSection, alternatePath = '', alternatePaths } = Astro.props;
const homeHref = locale ? localePath(locale) : sitePath();
const aboutLinks: Record<Locale, { label: string; path: string }[]> = {
  ru: [
    { label: 'О проекте', path: 'about' },
    { label: 'Наша команда', path: 'about/team' },
    { label: 'Наши эксперты', path: 'about/experts' },
    { label: 'Контакты для связи', path: 'about/contact' },
  ],
  kk: [
    { label: 'Жоба туралы', path: 'about' },
    { label: 'Біздің команда', path: 'about/team' },
    { label: 'Біздің сарапшылар', path: 'about/experts' },
    { label: 'Байланыс', path: 'about/contact' },
  ],
  en: [
    { label: 'About the project', path: 'about' },
    { label: 'Our team', path: 'about/team' },
    { label: 'Our experts', path: 'about/experts' },
    { label: 'Contact us', path: 'about/contact' },
  ],
};
---

<header class="site-header">
  <div class="site-header__top container">
    <a class="brand" href={homeHref} aria-label={SITE.name}>
      <img
        class="brand__symbol"
        src={`${sitePath()}brand/autism-hub-kazakhstan-mark.svg`}
        alt=""
        width="48"
        height="48"
        decoding="async"
      />
      <span class="brand__text">
        <span class="brand__name">{SITE.name}</span>
      </span>
    </a>

    {
      locale && (
        <div class="site-header__controls">
          <LanguageSwitcher
            current={locale}
            path={alternatePath}
            paths={alternatePaths}
          />
          <details class="nav-disclosure" open>
            <summary class="nav-disclosure__summary">
              <span>{UI[locale].menuLabel}</span>
              <span class="nav-disclosure__icon" aria-hidden="true"></span>
            </summary>
            <nav class="primary-nav" aria-label={UI[locale].primaryNavigation}>
              <ul>
                {SECTIONS.map((section) => (
                  <li>
                    {section === 'about' ? (
                      <details class="primary-nav__dropdown">
                        <summary aria-current={currentSection === 'about' ? 'page' : undefined}>
                          <span>{UI[locale].sections.about.title}</span>
                          <span class="primary-nav__caret" aria-hidden="true"></span>
                        </summary>
                        <ul class="primary-nav__submenu">
                          {aboutLinks[locale].map((link) => (
                            <li>
                              <a href={localePath(locale, link.path)}>{link.label}</a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    ) : (
                      <a
                        href={sectionPath(locale, section)}
                        aria-current={currentSection === section ? 'page' : undefined}
                      >
                        {UI[locale].sections[section].title}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        </div>
      )
    }
  </div>
</header>

<script>
  const mobileNavigation = window.matchMedia('(max-width: 80rem)');

  const syncNavigationDisclosure = (isMobile: boolean) => {
    document.querySelectorAll<HTMLDetailsElement>('.nav-disclosure').forEach((disclosure) => {
      disclosure.open = !isMobile;
    });
  };

  syncNavigationDisclosure(mobileNavigation.matches);
  mobileNavigation.addEventListener('change', (event) => {
    syncNavigationDisclosure(event.matches);
  });

  const hoverNavigation = window.matchMedia('(min-width: 80.001rem) and (hover: hover) and (pointer: fine)');
  const dropdowns = document.querySelectorAll<HTMLDetailsElement>('.primary-nav__dropdown');

  dropdowns.forEach((dropdown) => {
    const trigger = dropdown.querySelector('summary');

    dropdown.addEventListener('pointerenter', () => {
      delete dropdown.dataset.dismissed;
      if (hoverNavigation.matches) dropdown.open = true;
    });
    dropdown.addEventListener('pointerleave', () => {
      delete dropdown.dataset.dismissed;
      if (hoverNavigation.matches && !dropdown.contains(document.activeElement)) dropdown.open = false;
    });
    trigger?.addEventListener('click', (event) => {
      if (hoverNavigation.matches && event.detail > 0) {
        event.preventDefault();
        dropdown.open = true;
      }
    });
    dropdown.addEventListener('focusout', () => {
      queueMicrotask(() => {
        if (!dropdown.contains(document.activeElement) && !dropdown.matches(':hover')) {
          dropdown.open = false;
        }
      });
    });
    dropdown.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && dropdown.open) {
        event.preventDefault();
        dropdown.dataset.dismissed = 'true';
        dropdown.open = false;
        trigger?.focus();
      }
    });
  });

  document.addEventListener('pointerdown', (event) => {
    dropdowns.forEach((dropdown) => {
      if (!dropdown.contains(event.target as Node)) dropdown.open = false;
    });
  });
</script>
