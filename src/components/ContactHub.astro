    workItems: [
      { title: 'Сарапшы болу', detail: 'Авторлық, кәсіби кеңес беру және нақты материалдарға тәуелсіз рецензия жасау.', symbol: '01' },
      { title: 'Ұйымдар мен серіктестер', detail: 'Бірлескен білім беру бастамалары, зерттеу жобалары және қолжетімді ресурстарды дамыту.', symbol: '02' },
      { title: 'Қауымдастық ұсыныстары', detail: 'Жаңа тақырыптар, қолжетімділікті жақсарту, дәлсіздіктер және пайдалы дереккөздер.', symbol: '03' },
    ],
    supportEyebrow: 'ЖОБАНЫ ҚОЛДАУ',
