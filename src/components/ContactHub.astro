    mainTitle: 'Get in touch with AutismHub',
    mainDetail: 'One shared project inbox will be used for enquiries. We do not plan to publish individual team members\' contact details.',
    mailTitle: 'Official project email',
    mailReady: 'Email address', mailPending: 'Project email is being set up',
    mailAction: 'Send an email',
