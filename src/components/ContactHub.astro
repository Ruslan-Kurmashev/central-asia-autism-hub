const c = translations[locale];
const contactHref = CONTACT_CHANNELS.email ? 'mailto:' + CONTACT_CHANNELS.email : null;
const channelCards: Array<{ id: ChannelKey; glyph: string; href: string | null }> = [
  { id: 'linkedin', glyph: 'in', href: CONTACT_CHANNELS.linkedin },
  { id: 'telegram', glyph: '↗', href: CONTACT_CHANNELS.telegram },
  { id: 'instagram', glyph: 'IG', href: CONTACT_CHANNELS.instagramPersonal },
  { id: 'github', glyph: 'GH', href: CONTACT_CHANNELS.githubRepository },
];
---
<article class="contact-hub">
  <header class="contact-hub__hero">
    <div class="container">
      <nav class="contact-hub__breadcrumbs" aria-label={c.about}>
        <a href={localePath(locale)}>{c.home}</a>
        <span aria-hidden="true">/</span>
        <a href={sectionPath(locale, 'about')}>{c.about}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{c.title}</span>
      </nav>
      <p class="contact-hub__eyebrow">{c.eyebrow}</p>
      <h1>{c.title}</h1>
      <p class="contact-hub__lead">{c.lead}</p>
    </div>
  </header>

  <section id="contact-main" class="contact-hub__section contact-hub__section--main" aria-labelledby="contact-main-heading">
    <div class="container contact-hub__split">
      <div class="contact-hub__section-intro">
        <p class="contact-hub__eyebrow">{c.mainLabel}</p>
        <h2 id="contact-main-heading">{c.mainTitle}</h2>
        <p>{c.mainDetail}</p>
      </div>
      <div class="contact-hub__inbox">
        <div class="contact-hub__inbox-title">
          <span class="contact-hub__inbox-symbol" aria-hidden="true">✉</span>
          <div>
            <h3>{c.mailTitle}</h3>
            <p class="contact-hub__inbox-state">{CONTACT_CHANNELS.email ? c.mailReady : c.mailPending}</p>
          </div>
        </div>
        {CONTACT_CHANNELS.email ? (
          <>
            <a class="contact-hub__email" href={'mailto:' + CONTACT_CHANNELS.email}>{CONTACT_CHANNELS.email}</a>
            <a class="contact-hub__button" href={'mailto:' + CONTACT_CHANNELS.email}>{c.mailAction} <span aria-hidden="true">↗</span></a>
          </>
        ) : (
          <>
            <p>{c.fallback}</p>
            <a class="contact-hub__button" href={CONTACT_CHANNELS.githubIssues} rel="external">{c.githubAction} <span aria-hidden="true">↗</span></a>
          </>
        )}
        <p class="contact-hub__privacy-notice">{c.githubNotice}</p>
      </div>
    </div>
  </section>

  <section class="contact-hub__section contact-hub__section--channels" aria-labelledby="contact-channels-heading">
    <div class="container">
      <div class="contact-hub__section-intro">
        <p class="contact-hub__eyebrow">02</p>
        <h2 id="contact-channels-heading">{c.channelsTitle}</h2>
        <p>{c.channelsLead}</p>
      </div>
      <div class="contact-hub__channel-grid">
        {channelCards.map((ch) => {
          const label = c.channelLabels[ch.id];
          return (
            <div class={'contact-hub__channel' + (ch.href ? ' contact-hub__channel--active' : '')}>
              <div class="contact-hub__channel-top">
                <span class="contact-hub__channel-mark" aria-hidden="true">{ch.glyph}</span>
                <span class="contact-hub__channel-status">{ch.href ? c.currentChannel : c.plannedChannel}</span>
              </div>
              <h3>{label.title}</h3>
              <p>{label.description}</p>
              {ch.href ? (
                <a href={ch.href} class="contact-hub__channel-link" rel="external">{label.action} <span aria-hidden="true">↗</span></a>
              ) : (
                <span class="contact-hub__channel-pending">{c.plannedChannel}</span>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section class="contact-hub__section contact-hub__section--work" aria-labelledby="contact-work-heading">
    <div class="container">
      <div class="contact-hub__section-intro">
        <p class="contact-hub__eyebrow">03</p>
        <h2 id="contact-work-heading">{c.workTitle}</h2>
        <p>{c.workLead}</p>
      </div>
      <div class="contact-hub__work-grid">
        {c.workItems.map((item) => (
          <div class="contact-hub__work-card">
            <span class="contact-hub__index" aria-hidden="true">{item.symbol}</span>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </div>
        ))}
      </div>
      {contactHref ? (
        <a href={contactHref} class="contact-hub__secondary-button">{c.workAction} <span aria-hidden="true">↗</span></a>
      ) : (
        <p class="contact-hub__privacy-notice">{c.privateContactPending}</p>
      )}
    </div>
  </section>

  <section class="contact-hub__section contact-hub__section--support" aria-labelledby="contact-support-heading">
    <div class="container">
      <div class="contact-hub__support-layout">
        <div>
          <p class="contact-hub__eyebrow">04 / {c.supportEyebrow}</p>
          <h2 id="contact-support-heading">{c.supportTitle}</h2>
          <p class="contact-hub__support-lead">{c.supportLead}</p>
          <div class="contact-hub__support-status">
            <strong>{c.supportStatus}</strong>
            <p>{c.supportNoPayments}</p>
          </div>
          <p class="contact-hub__support-principle">{c.supportPrinciple}</p>
          {contactHref ? (
            <a href={contactHref} class="contact-hub__secondary-button">{c.supportAction} <span aria-hidden="true">↗</span></a>
          ) : (
            <p class="contact-hub__privacy-notice">{c.privateContactPending}</p>
          )}
        </div>
        <div class="contact-hub__support-ways">
          {c.supportWays.map((way) => (
            <div class="contact-hub__support-way">
              <span class="contact-hub__index" aria-hidden="true">{way.symbol}</span>
              <div>
                <h3>{way.title}</h3>
                <p>{way.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="contact-hub__section contact-hub__section--trust" aria-labelledby="contact-trust-heading">
    <div class="container">
      <div class="contact-hub__section-intro">
        <p class="contact-hub__eyebrow">05</p>
        <h2 id="contact-trust-heading">{c.trustTitle}</h2>
        <p>{c.trustLead}</p>
      </div>
      <div class="contact-hub__trust-grid">
        {c.trustItems.map((item) => (
          <div class="contact-hub__trust-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
      <nav class="contact-hub__policy-links" aria-label={c.trustTitle}>
        <a href={localePath(locale, 'about/policies') + '#editorial'}>{c.editorial} <span aria-hidden="true">↗</span></a>
        <a href={localePath(locale, 'about/policies') + '#privacy'}>{c.privacy} <span aria-hidden="true">↗</span></a>
        <a href={localePath(locale, 'about/policies') + '#evidence-safety'}>{c.safety} <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </section>
  <div class="contact-hub__bottom"><div class="container"><a href={sectionPath(locale, 'about')}>← {c.back}</a></div></div>
</article>
