    trustItems: [
      { title: 'Редакциялық жауапкершілік', description: 'Дереккөздер, авторлық және тәуелсіз сараптама тек нақты болған жағдайда ғана көрсетіледі.' },
      { title: 'Жеке деректерді қорғау', description: 'Медициналық құжаттарды, балалардың фотосуреттерін, тексеру нәтижелерін және жеке тұлғаны анықтайтын мәліметтерді жібермеңіз.' },
