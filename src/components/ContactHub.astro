---
import type { Locale } from '../site.config';
import { localePath, sectionPath } from '../lib/urls';
import { CONTACT_CHANNELS } from '../data/contact-channels';
import '../styles/contact-hub.css';

const { locale } = Astro.props as { locale: Locale };

type ChannelKey = 'linkedin' | 'telegram' | 'instagram' | 'github';
type Copy = {
  home: string; about: string; eyebrow: string; title: string; lead: string;
  mainLabel: string; mainTitle: string; mainDetail: string;
  mailTitle: string; mailReady: string; mailPending: string; mailAction: string;
  fallback: string; githubAction: string; githubNotice: string; currentChannel: string; plannedChannel: string;
  channelsTitle: string; channelsLead: string; channelLabels: Record<ChannelKey, { title: string; description: string; action: string }>;
  workTitle: string; workLead: string; workAction: string; privateContactPending: string;
  workItems: { title: string; detail: string; symbol: string }[];
  supportEyebrow: string; supportTitle: string; supportLead: string;
  supportStatus: string; supportNoPayments: string;
  supportWays: { title: string; description: string; symbol: string }[];
  supportPrinciple: string; supportAction: string;
  trustTitle: string; trustLead: string; trustItems: { title: string; description: string }[];
  editorial: string; privacy: string; safety: string; back: string;
};
