    githubAction: 'Сайттағы ашық қатені хабарлау',
    githubNotice: 'Хабарласу үшін GitHub тіркелгісі қажет. Барлық өтініш ашық көрінеді: телефон нөмірлерін, құжаттарды, балалар туралы немесе медициналық мәліметтерді жарияламаңыз.',
    currentChannel: 'Қолжетімді', plannedChannel: 'Жақында',
    channelsTitle: 'Біздің платформалар',
    channelsLead: 'Жоба жаңалықтары мен оқу материалдарын қадағалаңыз. Сілтемелер тиісті парақшалар ашылғаннан кейін ғана қосылады.',
    channelLabels: {
      linkedin: { title: 'LinkedIn', description: 'Кәсіби жаңалықтар, сарапшылармен, ұйымдармен және зерттеушілермен ынтымақтастық.', action: 'LinkedIn парақшасын ашу' },
      telegram: { title: 'Telegram', description: 'Сайт жаңартулары, пайдалы мақалалар және ашық білім беру ресурстары.', action: 'Telegram арнасын ашу' },
      instagram: { title: 'Instagram', description: 'Жоба туралы ақпаратты негізін қалаушының жеке парақшасы арқылы тарату. Бұл ұйымның ресми аккаунты емес.', action: 'Жеке Instagram парақшасын ашу' },
