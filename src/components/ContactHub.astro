      { title: 'Spread the word', description: 'Share useful resources with people who may benefit from them.', symbol: '01' },
      { title: 'Share your expertise', description: 'Suggest a contribution, consultation or independent review of a resource.', symbol: '02' },
      { title: 'Explore a partnership', description: 'Help improve access to information and expand professional collaboration.', symbol: '03' },
    ],
    supportPrinciple: 'All support is voluntary and does not grant influence over scientific conclusions, editorial content or users\' access to information.',
    supportAction: 'Offer your support',
    trustTitle: 'Transparency and safety',
    trustLead: 'We explain who is responsible for the content, how to report an error and what not to submit through public contact channels.',
    trustItems: [
      { title: 'Editorial responsibility', description: 'Sources, authorship and independent review are identified only when they actually exist.' },
      { title: 'Personal-data protection', description: 'Please do not send medical records, children\'s photographs, assessment results or identifying personal details.' },
