    currentChannel: 'Доступно', plannedChannel: 'Скоро',
    channelsTitle: 'Наши площадки',
    channelsLead: 'Следите за развитием проекта и новыми образовательными материалами. Ссылки появляются только после создания соответствующих страниц.',
    channelLabels: {
      linkedin: { title: 'LinkedIn', description: 'Профессиональные новости, сотрудничество с экспертами, организациями и исследователями.', action: 'Перейти в LinkedIn' },
      telegram: { title: 'Telegram', description: 'Обновления сайта, полезные публикации и открытые образовательные ресурсы.', action: 'Открыть Telegram-канал' },
      instagram: { title: 'Instagram', description: 'Рассказы о проекте через личную страницу основателя. Это не официальный аккаунт организации.', action: 'Открыть личный Instagram' },
