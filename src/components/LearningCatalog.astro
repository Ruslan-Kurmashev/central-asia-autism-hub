---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../site.config';

interface Props {
  locale: Locale;
  entries: CollectionEntry<'learning'>[];
}
const { locale, entries } = Astro.props;
const copy = {
  ru: {
    heading: 'Каталог курсов и учебных материалов.',
    intro: 'Сочетайте фильтры по языку курса, аудитории и теме. Поиск уточняет результаты с учётом всех выбранных условий.',
    search: 'Поиск по названию или содержанию',
    placeholder: 'Например: коммуникация, развитие, аутизм',
    audience: 'Аудитория', language: 'Язык курса', topic: 'Тема',
    all: 'Все', parents: 'Родителям', professionals: 'Специалистам',
    topics: { autism: 'Основы аутизма', development: 'Развитие ребёнка', inclusion: 'Инклюзивное образование', support: 'Подходы к поддержке' },
    types: { course: 'Курс', module: 'Учебный модуль', lecture: 'Лекция', materials: 'Учебные материалы', webinar: 'Вебинар' },
    price: 'Стоимость', provider: 'Разработчик', duration: 'Продолжительность',
    open: 'Перейти к курсу', verified: 'Проверено', details: 'Как начать обучение', outcome: 'Что выдаётся после прохождения',
    count: 'Найдено', resultWord: 'курсов и модулей', noResults: 'По выбранным фильтрам курсы не найдены.',
    empty: 'Курсы пока готовятся к публикации.',
    notice: 'Обучение проходит на ресурсах указанных разработчиков. Autism Hub Kazakhstan не является организатором курсов. Доступ, документы и учебные единицы определяются организатором и могут изменяться.',
  },
  kk: {
    heading: 'Курстар мен оқу материалдарының каталогы.',
    intro: 'Курс тілі, аудитория және тақырып сүзгілерін бірге қолданыңыз. Іздеу таңдалған шарттарға сәйкес нәтижелерді нақтылайды.',
    search: 'Атауы немесе мазмұны бойынша іздеу',
    placeholder: 'Мысалы: коммуникация, даму, аутизм',
    audience: 'Кімге арналған', language: 'Курс тілі', topic: 'Тақырып',
    all: 'Барлығы', parents: 'Ата-аналарға', professionals: 'Мамандарға',
    topics: { autism: 'Аутизм негіздері', development: 'Баланың дамуы', inclusion: 'Инклюзивті білім беру', support: 'Қолдау тәсілдері' },
    types: { course: 'Курс', module: 'Оқу модулі', lecture: 'Дәріс', materials: 'Оқу материалдары', webinar: 'Вебинар' },
    price: 'Құны', provider: 'Дайындаған ұйым', duration: 'Ұзақтығы',
    open: 'Курсқа өту', verified: 'Тексерілді', details: 'Оқуды қалай бастауға болады', outcome: 'Оқуды аяқтаған соң не беріледі',
    count: 'Табылды', resultWord: 'курс пен модуль', noResults: 'Таңдалған сүзгілер бойынша курс табылмады.',
    empty: 'Курстар жариялауға дайындалып жатыр.',
    notice: 'Оқу көрсетілген ұйымдардың ресурстарында өтеді. Autism Hub Kazakhstan бұл курстарды өткізбейді. Оқуға қолжетімділік, құжаттар мен оқу бірліктерінің шарттарын ұйымдастырушы белгілейді және өзгерте алады.',
  },
  en: {
    heading: 'Catalogue of courses and learning materials.',
    intro: 'Combine course language, audience and topic filters. Text search narrows the results using all selected criteria.',
    search: 'Search by title or content',
    placeholder: 'For example: communication, development, autism',
    audience: 'Audience', language: 'Course language', topic: 'Topic',
    all: 'All', parents: 'Parents', professionals: 'Professionals',
    topics: { autism: 'Autism essentials', development: 'Child development', inclusion: 'Inclusive education', support: 'Support approaches' },
    types: { course: 'Course', module: 'Learning module', lecture: 'Lecture', materials: 'Learning materials', webinar: 'Webinar' },
    price: 'Price', provider: 'Developed by', duration: 'Duration',
    open: 'Go to course', verified: 'Checked', details: 'How to start', outcome: 'What you receive upon completion',
    count: 'Found', resultWord: 'courses and modules', noResults: 'No courses match the selected filters.',
    empty: 'Courses are being prepared for publication.',
    notice: 'Training takes place on the listed providers’ resources; Autism Hub Kazakhstan does not deliver these courses. Providers determine and may change access, completion documents and continuing education credits.',
  },
} as const;
const t = copy[locale];
const languages = {
  ru: {ru:'Русский', kk:'Казахский', en:'Английский'},
  kk: {ru:'Орысша', kk:'Қазақша', en:'Ағылшынша'},
  en: {ru:'Russian', kk:'Kazakh', en:'English'},
} as const;
const dateFormat = new Intl.DateTimeFormat(locale === 'ru' ? 'ru-KZ' : locale === 'kk' ? 'kk-KZ' : 'en-GB', { day:'numeric', month:'short', year:'numeric' });
const items = [...entries].sort((a, b) => a.data.title.localeCompare(b.data.title, locale));
const availableLanguages = (['ru', 'kk', 'en'] as const).filter((lang) => items.some((entry) => entry.data.languages.includes(lang)));
const availableTopics = [...new Set(items.map((entry) => entry.data.topicArea).filter((v): v is NonNullable<typeof v> => Boolean(v)))];
---

<section class="course-catalogue" aria-labelledby="learning-directory-title">
  <div class="course-catalogue__heading">
    <h2 id="learning-directory-title">{t.heading}</h2>
    <p>{t.intro}</p>
  </div>

  <div class="course-catalogue__filters" id="professionals-learning" role="search" aria-label={t.heading}>
    <label>
      <span>{t.language}</span>
      <select data-course-language>
        <option value="all">{t.all} ({items.length})</option>
        {availableLanguages.map((lang) => (
          <option value={lang}>
            {languages[locale][lang]} ({items.filter((entry) => entry.data.languages.includes(lang)).length})
          </option>
        ))}
      </select>
    </label>
    <label class="course-catalogue__search">
      <span>{t.search}</span>
      <input type="search" placeholder={t.placeholder} data-course-search />
    </label>
    <label>
      <span>{t.audience}</span>
      <select data-course-audience>
        <option value="all">{t.all} ({items.length})</option>
        <option value="parents">{t.parents} ({items.filter((entry) => entry.data.audience.includes('parents')).length})</option>
        <option value="professionals">{t.professionals} ({items.filter((entry) => entry.data.audience.includes('professionals')).length})</option>
      </select>
    </label>
    <label>
      <span>{t.topic}</span>
      <select data-course-topic>
        <option value="all">{t.all} ({items.length})</option>
        {availableTopics.map((topic) => (
          <option value={topic}>
            {t.topics[topic]} ({items.filter((entry) => entry.data.topicArea === topic).length})
          </option>
        ))}
      </select>
    </label>
  </div>

  {
    items.length > 0 ? (
      <>
        <p class="course-catalogue__count" data-course-result aria-live="polite">{t.count}: {items.length} {t.resultWord}</p>
        <div class="course-catalogue__list">
          {items.map((entry) => (
            <article
              class="course-catalogue__item"
              data-course-item
              data-audience={entry.data.audience.join(' ')}
              data-language={entry.data.languages.join(' ')}
              data-topic={entry.data.topicArea ?? ''}
              data-search-text={`${entry.data.title} ${entry.data.summary} ${entry.data.provider} ${entry.data.languages.map((l) => languages[locale][l]).join(" ")}`.toLocaleLowerCase()}
            >
              <div class="course-catalogue__body">
                <div class="course-catalogue__tags">
                  <span>{t.types[entry.data.learningKind ?? 'course']}</span>
                  {entry.data.audience.map((audience) => <span>{audience === 'parents' ? t.parents : t.professionals}</span>)}
                </div>
                <h3>{entry.data.title}</h3>
                <p class="course-catalogue__summary">{entry.data.summary}</p>
                <div class="course-catalogue__meta">
                  {entry.data.durationLabel && <span><strong>{t.duration}:</strong> {entry.data.durationLabel}</span>}
                  <span><strong>{t.language}:</strong> {entry.data.languages.map((l) => languages[locale][l]).join(', ')}</span>
                  <span><strong>{t.provider}:</strong> {entry.data.provider}</span>
                  {!['free', 'бесплатно', 'тегін'].includes(entry.data.costLabel.trim().toLocaleLowerCase()) && (
                    <span><strong>{t.price}:</strong> {entry.data.costLabel}</span>
                  )}
                </div>
                {entry.data.registrationStatus && (
                  <p class="course-catalogue__access"><strong>{t.details}:</strong> {entry.data.registrationStatus}</p>
                )}
                {entry.data.completionOutcome && (
                  <p class="course-catalogue__outcome"><strong>{t.outcome}:</strong> {entry.data.completionOutcome}</p>
                )}
                {entry.data.lastVerifiedAt && (
                  <small class="course-catalogue__checked">
                    {t.verified}: <time datetime={entry.data.lastVerifiedAt.toISOString()}>{dateFormat.format(entry.data.lastVerifiedAt)}</time>
                  </small>
                )}
              </div>
              <div class="course-catalogue__action">
                {entry.data.externalUrl && (
                  <a href={entry.data.externalUrl} target="_blank" rel="noopener noreferrer external">{t.open} <span aria-hidden="true">↗</span></a>
                )}
              </div>
            </article>
          ))}
        </div>
        <p class="course-catalogue__no-results" data-course-empty hidden>{t.noResults}</p>
      </>
    ) : (
      <p>{t.empty}</p>
    )
  }
  <p class="course-catalogue__notice">{t.notice}</p>
</section>

<script>
  const catalogue = document.querySelector<HTMLElement>('.course-catalogue');
  if (catalogue) {
    const search = catalogue.querySelector<HTMLInputElement>('[data-course-search]');
    const audience = catalogue.querySelector<HTMLSelectElement>('[data-course-audience]');
    const language = catalogue.querySelector<HTMLSelectElement>('[data-course-language]');
    const topic = catalogue.querySelector<HTMLSelectElement>('[data-course-topic]');
    const list = catalogue.querySelectorAll<HTMLElement>('[data-course-item]');
    const result = catalogue.querySelector<HTMLElement>('[data-course-result]');
    const empty = catalogue.querySelector<HTMLElement>('[data-course-empty]');
    type FilterKey = 'audience' | 'language' | 'topic';
    const matches = (item: HTMLElement, override?: FilterKey, candidate?: string) => {
      const query = (search?.value ?? '').trim().toLocaleLowerCase();
      const selectedAudience = override === 'audience' ? candidate : audience?.value;
      const selectedLanguage = override === 'language' ? candidate : language?.value;
      const selectedTopic = override === 'topic' ? candidate : topic?.value;
      return (
        (query === '' || (item.dataset.searchText ?? '').includes(query)) &&
        (!selectedAudience || selectedAudience === 'all' || (item.dataset.audience ?? '').split(' ').includes(selectedAudience)) &&
        (!selectedLanguage || selectedLanguage === 'all' || (item.dataset.language ?? '').split(' ').includes(selectedLanguage)) &&
        (!selectedTopic || selectedTopic === 'all' || item.dataset.topic === selectedTopic)
      );
    };
    const update = () => {
      let matched = 0;
      list.forEach((item) => {
        const visible = matches(item);
        item.hidden = !visible;
        if (visible) matched++;
      });
      if (result) {
        const prefix = result.dataset.label ?? result.textContent?.split(':')[0] ?? '';
        result.dataset.label = prefix;
        result.textContent = `${prefix}: ${matched}`;
      }
      if (empty) empty.hidden = matched !== 0;

      // Contextual counts: each menu previews how many courses match that
      // choice together with the OTHER active filters and the search query.
      const facets: { key: FilterKey; select: HTMLSelectElement | null }[] = [
        { key: 'audience', select: audience },
        { key: 'language', select: language },
        { key: 'topic', select: topic },
      ];
      facets.forEach(({ key, select }) => {
        if (!select) return;
        Array.from(select.options).forEach((option) => {
          const label = option.dataset.baseLabel ??
            (option.textContent ?? '').replace(/\s*\(\d+\)\s*$/, '').trim();
          option.dataset.baseLabel = label;
          const total = Array.from(list).filter((item) => matches(item, key, option.value)).length;
          option.textContent = `${label} (${total})`;
        });
      });
    };
    const applyLinkFilter = () => {
      if (window.location.hash === '#professionals-learning' && audience) {
        audience.value = 'professionals';
        update();
      }
    };
    applyLinkFilter();
    update();
    window.addEventListener('hashchange', applyLinkFilter);
    // All controls narrow the same result set. Changing one never clears others.
    search?.addEventListener('input', update);
    audience?.addEventListener('change', update);
    language?.addEventListener('change', update);
    topic?.addEventListener('change', update);
    window.addEventListener('pageshow', update);
  }
</script>

<style>
.course-catalogue { margin:2rem 0 2.6rem; }
.course-catalogue__heading {margin:0 0 1.6rem}
.course-catalogue__heading h2{font-family:var(--font-editorial);font-weight:500;font-size:var(--type-h2);line-height:1.2;color:#173d68;margin:0 0 .65rem}
.course-catalogue__heading p{color:#526c83;max-width:52rem;line-height:1.65;font-size:var(--type-body);margin:0}
.course-catalogue__filters{display:grid;grid-template-columns:minmax(9rem,1fr) minmax(16rem,1.7fr) repeat(2,minmax(9rem,1fr));gap:.9rem;padding:1.3rem;border-radius:.9rem;border:1px solid #d6e3ec;background:#f6f9fc}
.course-catalogue__filters label{display:grid;gap:.48rem;font-size:var(--type-meta);color:#405b73;font-weight:600;align-content:start}
.course-catalogue__filters input,.course-catalogue__filters select{width:100%;min-height:2.75rem;min-width:0;border:1px solid #cadce7;border-radius:.55rem;background:#fff;color:#173955;font:inherit;font-size:var(--type-control);padding:.65rem .75rem}
.course-catalogue__filters input:focus-visible,.course-catalogue__filters select:focus-visible,.course-catalogue__action a:focus-visible{outline:3px solid #2d6e9f;outline-offset:2px}
.course-catalogue__count{color:#526b81;font-size:var(--type-small);margin:1.4rem 0 .9rem}
.course-catalogue__list{display:grid;gap:.85rem}
.course-catalogue__item{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1.15rem;padding:1.55rem 1.4rem;border:1px solid #d6e3ec;border-radius:.9rem;background:#fff;align-items:start}
.course-catalogue__item[hidden],.course-catalogue__no-results[hidden]{display:none!important}
.course-catalogue__tags{display:flex;flex-wrap:wrap;gap:.35rem;margin-bottom:.8rem}
.course-catalogue__tags span{border-radius:1rem;padding:.25rem .65rem;background:#eef4f8;color:#315d7b;font-size:var(--type-meta);line-height:1.3;font-weight:600}

.course-catalogue__body h3{font:600 clamp(1.14rem,1.9vw,1.38rem)/1.3 Georgia,'Times New Roman',serif;color:#12395e;margin:0 0 .55rem}
.course-catalogue__summary{color:#4b6176;line-height:1.6;font-size:var(--type-control);max-width:47rem;margin:0 0 .9rem}
.course-catalogue__meta{display:flex;flex-wrap:wrap;gap:.4rem 1.1rem;font-size:var(--type-meta);color:#5c7183;line-height:1.5}
.course-catalogue__meta strong,.course-catalogue__access strong,.course-catalogue__outcome strong{color:#38546b;font-weight:600}
.course-catalogue__access,.course-catalogue__outcome{margin:.65rem 0 0;color:#5c7183;font-size:var(--type-meta);line-height:1.55}
.course-catalogue__checked{display:block;margin-top:.6rem;font-size:var(--type-caption);color:#72889a}
.course-catalogue__action{align-self:center;max-width:12rem}
.course-catalogue__action a{display:inline-block;padding:.75rem .95rem;text-align:center;background:#205f90;border-radius:.52rem;color:#fff;text-decoration:none;font-size:var(--type-control);font-weight:700;line-height:1.35}
.course-catalogue__action a:hover{background:#164d78;text-decoration:none;color:#fff}
.course-catalogue__no-results{padding:1.3rem;border:1px dashed #c2d3e0;border-radius:.7rem;color:#496277}
.course-catalogue__notice{max-width:66rem;border-top:1px solid #d8e3eb;margin:1.7rem 0 0;padding-top:1rem;color:#65798b;font-size:var(--type-meta);line-height:1.7}
@media(max-width:69rem){.course-catalogue__filters{grid-template-columns:repeat(2,minmax(0,1fr))}.course-catalogue__action{align-self:start}}
@media(max-width:47rem){.course-catalogue__filters{grid-template-columns:1fr}.course-catalogue__item{grid-template-columns:minmax(0,1fr)}.course-catalogue__action{grid-column:1;max-width:none}.course-catalogue__action a{width:100%}}
@media(max-width:26rem){.course-catalogue__item{padding:1.1rem;gap:.65rem}}
</style>
