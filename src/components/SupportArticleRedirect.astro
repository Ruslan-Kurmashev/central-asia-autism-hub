---
import { articlePath } from '../lib/urls';

interface Props {
  targetSlug: string;
}

const { targetSlug } = Astro.props;
const target = articlePath('ru', 'parents', targetSlug);
const canonical = new URL(target, Astro.site).toString();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonical} />
    <title>Статья объединена с основным материалом | Autism Hub Kazakhstan</title>
  </head>
  <body>
    <a href="#main-content">Перейти к содержанию</a>
    <main id="main-content">
      <h1>Статья объединена с основным материалом</h1>
      <p>Содержание этой публикации включено в более полный материал по теме.</p>
      <p><a href={target}>Перейти к обновлённой статье</a></p>
    </main>
  </body>
</html>
