---
import { UI } from '../i18n/ui';
import { CONTACT_CHANNELS } from '../data/contact-channels';
import { localePath } from '../lib/urls';
import { SITE, type Locale } from '../site.config';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const copy = UI[locale];
const year = new Date().getUTCFullYear();
const policiesPath = localePath(locale, 'about/policies');
const isNotFound = /\/404(?:\/|\.html)$/.test(Astro.url.pathname);
const viewCopy = {
  ru: { badge: 'Просмотры', title: 'Просмотры страниц', note: 'С начала учёта. Считаются загрузки счётчика, не люди.' },
  kk: { badge: 'Қаралым', title: 'Бет қаралымдары', note: 'Есеп басталғалы. Бұл адамдар саны емес, есептегіш жүктелген саны.' },
  en: { badge: 'Views', title: 'Page views', note: 'Since tracking began. Badge loads are counted, not individual people.' },
}[locale];
const badgeUrl = 'https://hits.sh/ruslan-kurmashev.github.io/central-asia-autism-hub.svg'
  + '?view=total&style=flat-square&color=315f94&labelColor=253d50&label='
  + encodeURIComponent(viewCopy.badge);
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <p class="site-footer__brand">{SITE.name}</p>
      <p>{copy.footerBoundary}</p>
    </div>
    <div>
      <p class="site-footer__status">{copy.footerStatus}</p>
      <nav class="site-footer__nav" aria-label={copy.footerNavigation}>
        <ul>
          <li><a href={`${policiesPath}#editorial`}>{copy.footerLinks.editorial}</a></li>
          <li><a href={`${policiesPath}#privacy`}>{copy.footerLinks.privacy}</a></li>
          <li><a href={`${policiesPath}#accessibility`}>{copy.footerLinks.accessibility}</a></li>
          <li><a href={`${localePath(locale, 'about/contact')}`}>{copy.footerLinks.contact}</a></li>
          {CONTACT_CHANNELS.email && (
            <li><a href={'mailto:' + CONTACT_CHANNELS.email}>{CONTACT_CHANNELS.email}</a></li>
          )}
        </ul>
      </nav>
      <a class="site-footer__repository" href={SITE.repositoryUrl} rel="external">
        {copy.repositoryLabel} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
  {!isNotFound && (
    <div
      class="container site-footer__visits"
      data-public-counter
      data-badge-url={badgeUrl}
      data-badge-alt={viewCopy.title}
      hidden
    >
      <div>
        <p class="site-footer__visits-title">{viewCopy.title}</p>
        <p class="site-footer__visits-note">{viewCopy.note}</p>
      </div>
    </div>
  )}
  <div class="container site-footer__legal">
    <p>© {year} {SITE.umbrellaName}</p>
  </div>
  {!isNotFound && (
    <script is:inline>
      (() => {
        const host = window.location.hostname.toLowerCase();
        if (!['ruslan-kurmashev.github.io', 'autismkz.com', 'www.autismkz.com'].includes(host)) return;

        const widget = document.querySelector('[data-public-counter]');
        if (!widget) return;

        const image = document.createElement('img');
        image.className = 'site-footer__visits-badge';
        image.alt = widget.getAttribute('data-badge-alt') || '';
        image.referrerPolicy = 'no-referrer';
        image.decoding = 'async';
        image.loading = 'eager';
        image.addEventListener('load', () => { widget.hidden = false; }, { once: true });
        image.src = widget.getAttribute('data-badge-url') || '';
        widget.prepend(image);
      })();
    </script>
  )}
</footer>
