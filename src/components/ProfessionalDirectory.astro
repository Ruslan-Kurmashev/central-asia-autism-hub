---
import type { CollectionEntry } from 'astro:content';
import { UI } from '../i18n/ui';
import { kazakhstanDocumentCount, kazakhstanDocumentGroups } from '../data/kazakhstan-professional-documents';
import { internationalGuidelineCountries, internationalGuidelineCount, publishedGuidelineKeys } from '../data/international-professional-guidelines';
import { articlePath, localePath, sectionPath } from '../lib/urls';
import { assessmentArticles } from '../data/professional-assessment';
import type { Locale } from '../site.config';
import '../styles/professionals-directory.css';

interface Props {
  locale: Locale;
  materials: CollectionEntry<'pages'>[];
}

const { locale, materials } = Astro.props;
const text = {
  ru: {
    eyebrow: 'Профессиональная библиотека',
    trainingLink: 'Обучение для специалистов',
    description: 'Практические рекомендации, профессиональные знания и инструменты для специалистов, работающих с аутичными людьми.',
    directions: 'направлений',
    items: 'документов и материалов в каталоге',
    published: 'Опубликовано',
    choose: 'Выберите направление',
    articles: 'Материалы направления',
    back: 'Все направления',
    preparing: 'Готовится',
    additional: 'Дополнительные опубликованные материалы',
    kzCategories: 'тематических групп',
    kzDocs: 'опубликованных обзоров',
  },
  kk: {
    eyebrow: 'Кәсіби ақпараттық кітапхана',
    trainingLink: 'Мамандарға арналған оқу',
    description: 'Аутист адамдармен жұмыс істейтін мамандарға арналған практикалық ұсынымдар, кәсіби ақпарат және жұмыс құралдары.',
    directions: 'бағыт',
    items: 'каталогтағы құжаттар мен материалдар',
    published: 'Жарияланғаны',
    choose: 'Бағытты таңдаңыз',
    articles: 'Бағыт материалдары',
    back: 'Барлық бағыттар',
    preparing: 'Әзірленуде',
    additional: 'Қосымша жарияланған материалдар',
    kzCategories: 'тақырыптық топ',
    kzDocs: 'құжат жоспарда',
  },
  en: {
    eyebrow: 'Professional resource library',
    trainingLink: 'Training for professionals',
    description: 'Practical guidance, professional references and tools for professionals working with autistic people.',
    directions: 'areas',
    items: 'catalogued documents and resources',
    published: 'Published',
    choose: 'Choose an area',
    articles: 'Resources in this area',
    back: 'All areas',
    preparing: 'In preparation',
    additional: 'Additional published resources',
    kzCategories: 'document categories',
    kzDocs: 'planned documents',
  },
} as const;
const copy = text[locale];
const trainingHref = `${sectionPath(locale, 'learning')}#professionals-learning`;

type Localized = Record<Locale, string>;
type GuidelineSubgroup = 'basics';
type PlannedResource = { id: string; title: Localized; subgroup?: GuidelineSubgroup };
const subgroupTitles: Record<GuidelineSubgroup | 'international' | 'kazakhstan', Localized> = {
  basics: { ru: 'Основы работы с рекомендациями', kk: 'Ұсынымдармен жұмыс негіздері', en: 'Working with guidelines' },
  international: { ru: 'Международные клинические руководства: по странам', kk: 'Халықаралық клиникалық нұсқаулықтар: елдер бойынша', en: 'International clinical guidelines by country' },
  kazakhstan: { ru: 'Документы Казахстана: клинические протоколы, законы, приказы и стандарты', kk: 'Қазақстан құжаттары: клиникалық хаттамалар, заңдар, бұйрықтар және стандарттар', en: 'Kazakhstan documents: clinical protocols, laws, orders and standards' },
};
type Group = {
  id: string;
  icon: keyof typeof icons;
  topic: string;
  title: Localized;
  description: Localized;
  resources: PlannedResource[];
};

// Editorial roadmap is navigation, not clinical content. Resource IDs are internal;
// visitors see only the sequence 1, 2, 3. New articles use a matching translationKey,
// for example "professionals-g01", and an existing professional topic ID.
const icons = {
  guidelines: '<svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg"><g fill="none" stroke="#174b98" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5h29l9 9v42a3 3 0 0 1-3 3H15a4 4 0 0 1-4-4V9a4 4 0 0 1 4-4z" fill="#fff"/><path d="M44 5v9h9" fill="#e7a930"/><path d="m19 26 3 3 5-6m5 3h13m-26 13 3 3 5-6m5 3h13m-26 13 3 3 5-6m5 3h13" stroke="#2266dd"/></g></svg>',
  families: '<svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg"><g stroke="#174b98" stroke-width="2.8" stroke-linejoin="round" stroke-linecap="round"><path d="M28 5h23a6 6 0 0 1 6 6v10a6 6 0 0 1-6 6H40l-7 6v-6h-5a6 6 0 0 1-6-6V11a6 6 0 0 1 6-6z" fill="#edf4fc"/><path d="M30 17h1m8 0h1m8 0h1" stroke="#2266dd" stroke-width="4"/><circle cx="18" cy="35" r="6" fill="#fff"/><circle cx="47" cy="36" r="6" fill="#fff"/><path d="M5 59v-3c0-7 6-12 13-12s13 5 13 12v3z" fill="#dceaff"/><path d="M34 59v-3c0-7 6-12 13-12s13 5 13 12v3z" fill="#ffe5b0"/><circle cx="32" cy="47" r="5" fill="#fff"/><path d="M23 60c0-5 4-8 9-8s9 3 9 8" fill="#fff"/></g></svg>',
  assessment: '<svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg"><g fill="none" stroke="#174b98" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="10" width="39" height="48" rx="4" fill="#fff"/><path d="M21 10V6h15v4" fill="#e7a930"/><path d="m17 23 3 3 5-6m5 3h9m-22 12 3 3 5-6m5 3h7m-20 12 3 3 5-6m5 3h4" stroke="#2266dd"/><circle cx="45" cy="45" r="10" fill="#edf4fc"/><path d="m52 52 9 9" stroke-width="4"/></g></svg>',
  evidence: '<svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg"><g fill="none" stroke="#174b98" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="m22 8 13 13-7 7-13-13z" fill="#edf4fc"/><path d="m17 7 5 5-7 7-5-5z" fill="#e7a930"/><path d="m30 28-8 8"/><circle cx="38" cy="35" r="4" fill="#2266dd"/><path d="M37 17c7 4 11 12 11 21 0 10-8 18-18 18-8 0-13-4-16-10M13 46h23M22 55h26M16 59h38"/></g></svg>',
  ethics: '<svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg"><g fill="none" stroke="#174b98" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M32 5 53 13v17c0 14-9 23-21 29C20 53 11 44 11 30V13z" fill="#edf4fc"/><path d="M32 10 48 17v13c0 10-6 18-16 23" fill="#dceaff" stroke="none"/><circle cx="32" cy="31" r="13" fill="#fff"/><path d="m25 31 5 5 10-11" stroke="#2266dd" stroke-width="4"/></g></svg>',
  tools: '<svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg"><g fill="none" stroke="#174b98" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><rect x="22" y="4" width="20" height="12" rx="3" fill="#dceaff"/><path d="M32 16v8m0-1 11 10-11 10-11-10z" fill="#ffe5b0"/><path d="M21 33H11v14m32-14h10v14"/><rect x="2" y="47" width="25" height="13" rx="3" fill="#edf4fc"/><rect x="37" y="47" width="25" height="13" rx="3" fill="#edf4fc"/><path d="M8 53h12m24 0h12" stroke="#2266dd"/></g></svg>',
};

const groups: Group[] = [
  {
    id: 'guidelines', icon: 'guidelines', topic: 'guidelines',
    title: { ru: 'Рекомендации и стандарты', kk: 'Ұсынымдар мен стандарттар', en: 'Guidelines and standards' },
    description: { ru: 'Профессиональные рекомендации, международные руководства, клинические протоколы и документы Казахстана', kk: 'Кәсіби ұсынымдар, халықаралық нұсқаулықтар, клиникалық хаттамалар және Қазақстан құжаттары', en: 'Professional guideline appraisal, international guidance, clinical protocols and Kazakhstan documents' },
    resources: [
      { id: 'g01', subgroup: 'basics', title: { ru: 'Как работать с профессиональными рекомендациями при аутизме', kk: 'Аутизм жөніндегі кәсіби ұсынымдармен қалай жұмыс істеуге болады', en: 'How to appraise professional autism guidelines' }},
    ],
  },
  {
    id: 'family-communication', icon: 'families', topic: 'family-communication',
    title: { ru: 'Работа с семьями', kk: 'Отбасылармен жұмыс', en: 'Working with families' },
    description: { ru: 'Коммуникация, информированное согласие и совместные решения', kk: 'Қарым-қатынас, ақпараттандырылған келісім және бірлескен шешімдер', en: 'Communication, informed consent and shared decisions' },
    resources: [
      { id: 'c01', title: { ru: 'Как обсуждать результаты скрининга с семьёй', kk: 'Скрининг нәтижелерін отбасымен қалай талқылау керек', en: 'Discussing screening results with families' }},
      { id: 'c02', title: { ru: 'Совместное принятие решений и информированное согласие', kk: 'Бірлесіп шешім қабылдау және ақпараттандырылған келісім', en: 'Shared decision-making and informed consent' }},
      { id: 'c03', title: { ru: 'Передача информации между семьёй, медициной и школой', kk: 'Отбасы, медицина ұйымы және мектеп арасындағы ақпарат алмасу', en: 'Information sharing between families, health services and schools' }},
      { id: 'c04', title: { ru: 'Как сообщать семье о диагнозе аутизма', kk: 'Отбасына аутизм диагнозын қалай түсіндіру керек', en: 'Communicating an autism diagnosis to families' }},
      { id: 'c05', title: { ru: 'Культурные, языковые и социальные особенности коммуникации с семьёй', kk: 'Отбасымен қарым-қатынастағы мәдени, тілдік және әлеуметтік ерекшеліктер', en: 'Culturally, linguistically and socially responsive family communication' }},
      { id: 'c06', title: { ru: 'Несогласие, тревога и конфликтные ситуации: профессиональное взаимодействие', kk: 'Келіспеушілік, алаңдаушылық және жанжалдар: кәсіби өзара әрекет', en: 'Managing disagreement, concerns and conflict with families' }},
    ],
  },
  {
    id: 'assessment-context', icon: 'assessment', topic: 'assessment-context',
    title: { ru: 'Оценка и диагностика', kk: 'Бағалау және диагностика', en: 'Assessment and diagnosis' },
    description: {
      ru: 'Пять профессиональных подразделов, 12 материалов и скачиваемые схемы, таблицы и рабочие формы.',
      kk: 'Бес кәсіби бөлім, 12 материал және жүктелетін жұмыс құралдары.',
      en: 'Five practical subgroups, 12 articles and downloadable clinical workflow resources.',
    },
    resources: assessmentArticles.map(a => ({ id: a.id, title: a.title })),
  },
  {
    id: 'evidence-support', icon: 'evidence', topic: 'evidence-support',
    title: { ru: 'Доказательность методов', kk: 'Әдістердің дәлелділігі', en: 'Evidence for approaches' },
    description: { ru: 'Исследования, эффективность и ограничения методов поддержки', kk: 'Қолдау тәсілдеріне қатысты зерттеулер, тиімділік және шектеулер', en: 'Research, effectiveness and limitations of support approaches' },
    resources: [
      { id: 'e01', title: { ru: 'Как оценивать научные исследования вмешательств', kk: 'Қолдау тәсілдері туралы ғылыми зерттеулерді қалай бағалау керек', en: 'How to appraise intervention research' }},
      { id: 'e02', title: { ru: 'AAC, NDBI, FCT и FBA: как оценивать результаты', kk: 'AAC, NDBI, FCT және FBA: нәтижелерді қалай бағалау керек', en: 'AAC, NDBI, FCT and FBA: assessing outcomes' }},
      { id: 'e03', title: { ru: 'Сенсорные и коммерческие методы: критическая оценка заявлений', kk: 'Сенсорлық және коммерциялық әдістер: мәлімдемелерді сын тұрғысынан бағалау', en: 'Sensory and commercial approaches: critically assessing claims' }},
    ],
  },
  {
    id: 'ethics', icon: 'ethics', topic: 'ethics',
    title: { ru: 'Этика и безопасность', kk: 'Этика және қауіпсіздік', en: 'Ethics and safety' },
    description: { ru: 'Права человека, профессиональные границы и защита данных', kk: 'Адам құқықтары, кәсіби шекаралар және деректерді қорғау', en: 'Human rights, professional boundaries and data protection' },
    resources: [
      { id: 'h01', title: { ru: 'Клинические риски и границы компетенции', kk: 'Клиникалық қауіптер және құзырет шекаралары', en: 'Clinical risks and professional scope' }},
      { id: 'h02', title: { ru: 'Этика поддержки и права аутичного человека', kk: 'Қолдау этикасы және аутист адамдардың құқықтары', en: "Ethics of support and autistic people's rights" }},
      { id: 'h03', title: { ru: 'Конфиденциальность, персональные данные и цифровые инструменты', kk: 'Құпиялылық, дербес деректер және цифрлық құралдар', en: 'Confidentiality, personal data and digital tools' }},
    ],
  },
  {
    id: 'practice-tools', icon: 'tools', topic: 'practice-tools',
    title: { ru: 'Алгоритмы и инструменты', kk: 'Алгоритмдер мен құралдар', en: 'Workflows and tools' },
    description: { ru: 'Междисциплинарная маршрутизация, практические чек-листы, индивидуальные планы и мониторинг', kk: 'Пәнаралық бағыттау, практикалық тексеру парақтары, жеке жоспарлар және мониторинг', en: 'Multidisciplinary referral pathways, practical checklists, support plans and monitoring' },
    resources: [
      // Keep g03 so a future publication can retain its planned translationKey (professionals-g03).
      { id: 'g03', title: { ru: 'Междисциплинарное взаимодействие и маршрутизация семьи', kk: 'Пәнаралық өзара іс-қимыл және отбасын тиісті қызметтерге бағыттау', en: 'Multidisciplinary coordination and family referral pathways' }},
      { id: 't01', title: { ru: 'Индивидуальный план поддержки: цели и мониторинг', kk: 'Жеке қолдау жоспары: мақсаттар және мониторинг', en: 'Individual support plans: goals and monitoring' }},
      { id: 't02', title: { ru: 'Оценка AAC: выбор средств коммуникации и мониторинг', kk: 'AAC бағалау: коммуникация құралдарын таңдау және мониторинг', en: 'AAC assessment: selecting communication supports and monitoring' }},
      { id: 't03', title: { ru: 'Структурированное наблюдение и FBA', kk: 'Құрылымдалған бақылау және FBA', en: 'Structured observation and FBA' }},
      { id: 't04', title: { ru: 'Адаптации среды в классе и на приёме', kk: 'Сыныптағы және қабылдаудағы ортаны бейімдеу', en: 'Environmental accommodations in classrooms and consultations' }},
    ],
  },
];
const plannedCount = groups.reduce((total, group) => total + group.resources.length, kazakhstanDocumentCount + internationalGuidelineCount);
const kazakhstanHubHref = localePath(locale, 'professionals/kazakhstan-documents');
const publishedCount = materials.length;
const sectionTitle = UI[locale].sections.professionals.title;
function countLabel(n: number) {
  if (locale === 'en') return n === 1 ? 'resource' : 'resources';
  if (locale === 'kk') return 'материал';
  const lastTwo = n % 100;
  if (lastTwo >= 11 && lastTwo <= 14) return 'материалов';
  const last = n % 10;
  if (last === 1) return 'материал';
  if (last >= 2 && last <= 4) return 'материала';
  return 'материалов';
}
const forGroup = (group: Group) => {
  const records = materials.filter((material) => material.data.topic === group.topic && !(group.id === 'guidelines' && (publishedGuidelineKeys.has(material.data.translationKey) || kazakhstanDocumentGroups.some((category) => category.documents.some((document) => document.translationKey === material.data.translationKey)))));
  const matched = group.resources.map((resource) => ({
    resource,
    record: records.find((material) => material.data.translationKey === 'professionals-' + resource.id),
  }));
  const extra = records.filter((material) =>
    !matched.some((entry) => entry.record?.data.slug === material.data.slug)
  );
  return { matched, extra, count: group.resources.length + extra.length + (group.id === 'guidelines' ? kazakhstanDocumentCount + internationalGuidelineCount : 0) };
};
---

<div class="professional-directory">
  <p class="professional-directory__breadcrumb">
    <a href={localePath(locale)}>{UI[locale].homeLabel}</a>
    <span aria-hidden="true"> / </span>
    <span>{sectionTitle}</span>
  </p>

  <div id="professional-overview" class="professional-directory__overview">
    <header class="professional-directory__intro">
      <p class="professional-directory__eyebrow">{copy.eyebrow}</p>
      <div class="professional-directory__title-row">
        <h1>{sectionTitle}</h1>
        <a class="professional-directory__training-link" href={trainingHref}>{copy.trainingLink} <span aria-hidden="true">→</span></a>
      </div>
      <p class="professional-directory__lead">{copy.description}</p>
      <p class="professional-directory__statistics">
        <strong>{groups.length}</strong> {copy.directions}
        <span aria-hidden="true">·</span>
        <strong>{plannedCount}</strong> {copy.items}
        <span aria-hidden="true">·</span>
        {copy.published}: <strong>{publishedCount}</strong>
      </p>
    </header>

    <section aria-labelledby="professional-areas-title">
      <h2 id="professional-areas-title">{copy.choose}</h2>
      <div class="professional-directory__grid">
        {groups.map((group) => {
          const { count } = forGroup(group);
          return (
            <a class="professional-directory__card" href={group.id === 'assessment-context' ? localePath(locale, 'professionals/assessment') : '#professional-' + group.id}>
              <span class="professional-directory__icon" aria-hidden="true" set:html={icons[group.icon]}></span>
              <strong class="professional-directory__card-title">{group.title[locale]}</strong>
              <span class="professional-directory__card-description">{group.description[locale]}</span>
              <span class="professional-directory__card-footer">
                <span>{count} {countLabel(count)}</span>
                <span class="professional-directory__arrow" aria-hidden="true">→</span>
              </span>
            </a>
          );
        })}
      </div>
    </section>
  </div>

  {groups.map((group) => {
    const { matched, extra, count } = forGroup(group);
    return (
      <section
        id={'professional-' + group.id}
        class="professional-directory__detail"
        aria-labelledby={'professional-title-' + group.id}
      >
        <a class="professional-directory__back" href="#professional-overview">
          <span aria-hidden="true">←</span> {copy.back}
        </a>
        <div class="professional-directory__detail-header">
          <span class="professional-directory__icon" aria-hidden="true" set:html={icons[group.icon]}></span>
          <p class="professional-directory__eyebrow">{copy.eyebrow}</p>
          <div class="professional-directory__title-row">
            <h2 class="professional-directory__detail-title" id={'professional-title-' + group.id}>{group.title[locale]}</h2>
            <a class="professional-directory__training-link" href={trainingHref}>{copy.trainingLink} <span aria-hidden="true">→</span></a>
          </div>
          <p class="professional-directory__lead">{group.description[locale]}</p>
          {group.id === 'assessment-context' && (
            <a class="professional-directory__practice-link" style="margin-top:1.2rem; display:inline-flex;" href={localePath(locale,'professionals/assessment')}>
              {locale === 'ru' ? 'Открыть практическую библиотеку и файлы' : locale === 'kk' ? 'Практикалық кітапхана мен файлдарды ашу' : 'Open practice hub and downloads'} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
        <div class="professional-directory__list-heading">
          <h3>{copy.articles}</h3>
          <span class="professional-directory__pill">{count} {countLabel(count)}</span>
        </div>
        <ol class="professional-directory__list">
          {matched.map(({ resource, record }, index) => (
            <>
              {group.id === 'guidelines' && resource.subgroup && (index === 0 || matched[index - 1].resource.subgroup !== resource.subgroup) && (
                <li class="professional-directory__subgroup"><h4>{subgroupTitles[resource.subgroup][locale]}</h4></li>
              )}
              <li class="professional-directory__item">
              {record ? (
                <a class="professional-directory__item-link" href={articlePath(locale, 'professionals', record.data.slug)}>
                  <span class="professional-directory__item-title">{record.data.title}</span>
                  <span class="professional-directory__item-arrow" aria-hidden="true">→</span>
                </a>
              ) : (
                <span class="professional-directory__item-pending">
                  <span class="professional-directory__item-title">{resource.title[locale]}</span>
                  <span class="professional-directory__status">{copy.preparing}</span>
                </span>
              )}
              </li>
            </>
          ))}
          {group.id === 'guidelines' && (
            <>
              <li class="professional-directory__subgroup">
                <h4>{subgroupTitles.international[locale]}</h4>
              </li>
              {internationalGuidelineCountries.map((country) => {
                const published = country.documents.filter((doc) => materials.some((entry) => entry.data.translationKey === doc.translationKey)).length;
                const countryCount = locale === 'ru'
                  ? published > 0 ? `${published} опубликованных обзора` : `${country.documents.length} официальных документов · обзоры готовятся`
                  : locale === 'kk'
                    ? published > 0 ? `${published} жарияланған шолу` : `${country.documents.length} ресми құжат · шолулар әзірленуде`
                    : published > 0 ? `${published} published reviews` : `${country.documents.length} official documents · reviews in preparation`;
                return (
                  <li class="professional-directory__item professional-directory__item--folder">
                    <a class="professional-directory__item-link" href={localePath(locale, 'professionals/international-guidelines/' + country.id)}>
                      <span class="professional-directory__item-title">{country.title[locale]} <small>{countryCount}</small></span>
                      <span class="professional-directory__item-arrow" aria-hidden="true">→</span>
                    </a>
                  </li>
                );
              })}
              <li class="professional-directory__subgroup">
                <h4><a class="professional-directory__subgroup-link" href={kazakhstanHubHref}>{subgroupTitles.kazakhstan[locale]} <span aria-hidden="true">→</span></a></h4>
              </li>
              <li class="professional-directory__item professional-directory__item--folder">
                <a class="professional-directory__item-link" href={kazakhstanHubHref}>
                  <span class="professional-directory__item-title">{kazakhstanDocumentGroups.length} {copy.kzCategories} <small>{kazakhstanDocumentCount} {copy.kzDocs}</small></span>
                  <span class="professional-directory__item-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            </>
          )}
          {extra.map((record) => (
            <li class="professional-directory__item">
              <a class="professional-directory__item-link" href={articlePath(locale, 'professionals', record.data.slug)}>
                <span class="professional-directory__item-title">{record.data.title}</span>
                <span class="professional-directory__item-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    );
  })}
</div>