---
import { getCollection } from 'astro:content';
import ArticleCard from '../../../../components/ArticleCard.astro';
import { CONTENT_UI, DATE_LOCALES } from '../../../../i18n/content';
import { UI } from '../../../../i18n/ui';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { articlePath, localePath } from '../../../../lib/urls';
import {
  SECTIONS,
  SITE,
  SUPPORTED_LOCALES,
  type Locale,
  type Section,
} from '../../../../site.config';
import '../../../../styles/section-v2.css';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.flatMap((locale) =>
    SECTIONS.map((section) => ({
      params: { lang: locale, section },
      props: { locale, section },
    })),
  );
}

interface Props {
  locale: Locale;
  section: Section;
}

const { locale, section } = Astro.props;
const copy = UI[locale];
const contentCopy = CONTENT_UI[locale];
const sectionCopy = copy.sections[section];
const useSectionV2 = ['ru', 'en', 'kk'].includes(locale);
const sectionV2Text = locale === 'en'
  ? {
      resourceWord: (count: number) => count === 1 ? 'resource' : 'resources',
      navigation: 'Explore this section',
      resourcesAndTopics: 'Resources and topics',
      topics: 'Section topics',
      hasMaterials: 'Open a topic to browse published resources. New resources appear here after editorial checks.',
      noMaterials: 'This section is being prepared. Resources will be added after their content and sources have been checked.',
      otherParent: 'Other resources',
      otherGeneral: 'Additional resources',
      otherParentDescription: 'Published resources that do not yet belong to a main topic group.',
      otherGeneralDescription: 'Published resources not yet assigned to a section topic.',
      structure: 'Section structure',
      primaryTopics: 'Main topics',
      emptyGroup: 'Resources for this topic are in preparation.',
    }
  : locale === 'kk'
    ? {
        resourceWord: (_count: number) => 'материал',
        navigation: 'Бөлім бойынша навигация',
        resourcesAndTopics: 'Материалдар мен тақырыптар',
        topics: 'Бөлім тақырыптары',
        hasMaterials: 'Жарияланған материалдарды көру үшін тақырыпты ашыңыз. Жаңа материалдар мазмұны мен дереккөздері тексерілгеннен кейін қосылады.',
        noMaterials: 'Бөлімнің негізгі бағыттары анықталды. Материалдар мазмұны мен дереккөздері тексерілгеннен кейін біртіндеп қосылады.',
        otherParent: 'Басқа материалдар',
        otherGeneral: 'Қосымша материалдар',
        otherParentDescription: 'Әзірге негізгі тақырыптық топтарға енгізілмеген жарияланған материалдар.',
        otherGeneralDescription: 'Бұл бөлімнің тақырыптарына әлі бөлінбеген жарияланған материалдар.',
        structure: 'Бөлім құрылымы',
        primaryTopics: 'Негізгі тақырыптар',
        emptyGroup: 'Осы тақырып бойынша материалдар әзірленіп жатыр.',
      }
    : {
      resourceWord: russianMaterialWord,
      navigation: 'Навигация по разделу',
      resourcesAndTopics: 'Материалы и темы',
      topics: 'Темы раздела',
      hasMaterials: 'Откройте тему, чтобы увидеть опубликованные материалы. Новые статьи автоматически появляются в этом разделе после публикации.',
      noMaterials: 'Основные направления раздела уже определены. Материалы будут добавляться постепенно после проверки содержания и источников.',
      otherParent: 'Другие материалы',
      otherGeneral: 'Все остальные материалы',
      otherParentDescription: 'Материалы, которые ещё не распределены по основной навигации.',
      otherGeneralDescription: 'Опубликованные материалы, которые пока не привязаны к одной из навигационных тем раздела.',
      structure: 'Структура раздела',
      primaryTopics: 'Основные темы',
      emptyGroup: 'Материалы этой темы готовятся.',
    };

const pageMaterials = await getCollection(
  'pages',
  ({ data }) =>
    !data.draft &&
    data.language === locale &&
    data.section === section &&
    data.translationStatus !== 'pending' &&
    Boolean(data.publishedAt) &&
    Boolean(data.updatedAt),
);

const researchMaterials =
  section === 'research'
    ? await getCollection(
        'research',
        ({ data }) =>
          !data.draft &&
          data.language === locale &&
          data.translationStatus !== 'pending' &&
          Boolean(data.publishedAt) &&
          Boolean(data.updatedAt),
      )
    : [];

const materials = [...pageMaterials, ...researchMaterials].sort((left, right) => {
  const publishedDiff =
    (right.data.publishedAt?.getTime() ?? 0) -
    (left.data.publishedAt?.getTime() ?? 0);

  if (publishedDiff !== 0) return publishedDiff;

  const updatedDiff =
    (right.data.updatedAt?.getTime() ?? 0) -
    (left.data.updatedAt?.getTime() ?? 0);

  if (updatedDiff !== 0) return updatedDiff;

  return left.data.title.localeCompare(right.data.title, locale);
});

const dateFormatter = new Intl.DateTimeFormat(DATE_LOCALES[locale], {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const parentGroupDefinitions = [
  {
    id: 'autism-basics',
    title: 'Что такое аутизм',
    description:
      'Основные понятия, особенности аутистического спектра и понятный вводный материал.',
    topics: ['autism-basics'],
  },
  {
    id: 'development',
    title: 'Развитие ребёнка',
    description:
      'Ориентиры развития и ситуации, которые стоит обсудить со специалистом.',
    topics: ['child-development', 'development-concerns'],
  },
  {
    id: 'assessment',
    title: 'Оценка и диагностика',
    description:
      'Скрининг, диагностическая оценка, обследования и роли специалистов в Казахстане.',
    topics: [
      'assessment-and-diagnosis',
      'autism-assessments-kazakhstan',
      'autism-diagnosis-kazakhstan',
      'autism-pmpk-vkk-mse-kazakhstan',
    ],
  },
  {
    id: 'after-diagnosis',
    title: 'После оценки и диагноза',
    description:
      'Как понять результат оценки и какие практические шаги могут быть следующими.',
    topics: [
      'after-autism-assessment-kazakhstan',
      'first-30-days-after-autism-diagnosis-kazakhstan',
    ],
  },
  {
    id: 'support',
    title: 'Подходы к поддержке',
    description:
      'Коммуникация, обучение, поведение, сенсорная поддержка, физическая активность и другие подходы.',
    topics: ['approaches-to-support'],
  },
  {
    id: 'feeding',
    title: 'Питание и трудности кормления',
    description:
      'Оценка трудностей питания, ARFID, помощь при кормлении и нутриционная поддержка.',
    topics: ['feeding-nutrition'],
  },
];

const englishParentGroups: Record<string, { title: string; description: string }> = {
  'autism-basics': {
    title: 'Understanding autism',
    description: 'Core concepts, characteristics of autism and an accessible introduction.',
  },
  development: {
    title: 'Child development',
    description: 'Developmental milestones and questions to discuss with a professional.',
  },
  assessment: {
    title: 'Assessment and diagnosis',
    description: 'Screening, diagnostic assessment and professional roles in Kazakhstan.',
  },
  'after-diagnosis': {
    title: 'After assessment and diagnosis',
    description: 'Understanding assessment results and possible next steps.',
  },
  support: {
    title: 'Approaches to support',
    description: 'Communication, learning, sensory and other individualised supports.',
  },
  feeding: {
    title: 'Eating and feeding',
    description: 'Feeding difficulties, assessment and nutritional support.',
  },
};

const kazakhParentGroups: Record<string, { title: string; description: string }> = {
  'autism-basics': {
    title: 'Аутизм туралы негізгі түсінік',
    description: 'Аутизмнің ерекшеліктері, негізгі ұғымдар және түсінікті кіріспе ақпарат.',
  },
  development: {
    title: 'Баланың дамуы',
    description: 'Даму кезеңдері және маманмен талқылауға болатын мәселелер.',
  },
  assessment: {
    title: 'Бағалау және диагностика',
    description: 'Скрининг, кешенді бағалау, диагностика және Қазақстандағы мамандардың рөлі.',
  },
  'after-diagnosis': {
    title: 'Бағалау мен диагноздан кейін',
    description: 'Бағалау нәтижесін түсіну және келесі қадамдарды жоспарлау.',
  },
  support: {
    title: 'Қолдау тәсілдері',
    description: 'Коммуникация, оқу, сенсорлық қолдау және жеке қажеттіліктерге сай көмек.',
  },
  feeding: {
    title: 'Тамақтану және тамақтандыру қиындықтары',
    description: 'Тамақтану қиындықтары, оларды бағалау және тағамдық қолдау.',
  },
};

const genericGroupDefinitions = sectionCopy.topics.map((topic) => ({
  id: topic.id,
  title: topic.title,
  description: topic.description,
  topics: [topic.id],
}));

const groupDefinitions =
  section === 'parents'
    ? parentGroupDefinitions.map((group) => ({
        ...group,
        title: locale === 'en'
          ? englishParentGroups[group.id].title
          : locale === 'kk'
            ? kazakhParentGroups[group.id].title
            : group.title,
        description: locale === 'en'
          ? englishParentGroups[group.id].description
          : locale === 'kk'
            ? kazakhParentGroups[group.id].description
            : group.description,
      }))
    : genericGroupDefinitions;

const sectionGroups = groupDefinitions.map((group) => ({
  ...group,
  materials: materials.filter((material) =>
    group.topics.includes(material.data.topic),
  ),
}));

const visibleGroups =
  section === 'parents'
    ? sectionGroups
    : sectionGroups.filter((group) => group.materials.length > 0);

const initiallyOpenGroupId =
  visibleGroups.find((group) => group.materials.length > 0)?.id ??
  visibleGroups[0]?.id;

const groupedSlugs = new Set(
  visibleGroups.flatMap((group) =>
    group.materials.map((material) => material.data.slug),
  ),
);

const ungroupedMaterials = materials.filter(
  (material) => !groupedSlugs.has(material.data.slug),
);

function russianMaterialWord(count: number) {
  const lastTwo = count % 100;
  const last = count % 10;

  if (lastTwo >= 11 && lastTwo <= 14) return 'материалов';
  if (last === 1) return 'материал';
  if (last >= 2 && last <= 4) return 'материала';
  return 'материалов';
}
---

<BaseLayout
  title={`${sectionCopy.title} - ${SITE.name}`}
  description={sectionCopy.description}
  locale={locale}
  currentSection={section}
  alternatePath={section}
  bodyClass={useSectionV2 ? 'section-v2' : undefined}
>
  {
    useSectionV2 ? (
      <article class="section-v2__page">
        <header class="section-v2__hero">
          <div class="container">
            <p class="section-v2__breadcrumb">
              <a href={localePath(locale)}>{copy.homeLabel}</a>
              <span aria-hidden="true"> / </span>
              <span aria-current="page">{sectionCopy.title}</span>
            </p>

            <div class="section-v2__hero-grid">
              <div>
                <p class="section-v2__eyebrow">Autism Hub Kazakhstan</p>
                <h1>{sectionCopy.title}</h1>
                <p class="section-v2__description">{sectionCopy.description}</p>
              </div>

              <div
                class="section-v2__count"
                aria-label={`${materials.length} ${sectionV2Text.resourceWord(materials.length)}`}
              >
                <strong>{materials.length}</strong>
                <span>{sectionV2Text.resourceWord(materials.length)}</span>
              </div>
            </div>
          </div>
        </header>

        <section
          class="section-v2__collections"
          aria-labelledby="section-v2-collections-title"
        >
          <div class="container">
            <div class="section-v2__intro">
              <p class="section-v2__eyebrow">{sectionV2Text.navigation}</p>
              <h2 id="section-v2-collections-title">
                {materials.length > 0 ? sectionV2Text.resourcesAndTopics : sectionV2Text.topics}
              </h2>
              <p>
                {materials.length > 0 ? sectionV2Text.hasMaterials : sectionV2Text.noMaterials}
              </p>
            </div>

            {materials.length > 0 && (
              <div class="section-v2__accordion">
                {visibleGroups.map((group, index) => (
                  <details
                    class="section-v2__group"
                    id={group.id}
                    open={group.id === initiallyOpenGroupId}
                  >
                    <summary>
                      <span class="section-v2__number" aria-hidden="true">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span class="section-v2__group-copy">
                        <strong>{group.title}</strong>
                        <span>{group.description}</span>
                      </span>
                      <span class="section-v2__group-count">
                        {group.materials.length}{' '}
                        {sectionV2Text.resourceWord(group.materials.length)}
                      </span>
                      <span
                        class="section-v2__chevron"
                        aria-hidden="true"
                      ></span>
                    </summary>

                    <div class="section-v2__article-list">
                      {group.materials.length > 0 ? (
                        group.materials.map((material, materialIndex) => (
                          <a
                            class:list={[
                              'section-v2__article-row',
                              material.data.featuredImage && 'section-v2__article-row--image',
                            ]}
                            href={articlePath(
                              locale,
                              section,
                              material.data.slug,
                            )}
                          >
                            <span
                              class="section-v2__article-index"
                              aria-hidden="true"
                            >
                              {String(materialIndex + 1).padStart(2, '0')}
                            </span>
                            {material.data.featuredImage && (
                              <img
                                class="section-v2__article-thumb"
                                src={material.data.featuredImage}
                                alt=""
                                loading="lazy"
                                decoding="async"
                                width="96"
                                height="72"
                              />
                            )}
                            <span class="section-v2__article-copy">
                              <strong>{material.data.title}</strong>
                              <span>{material.data.summary}</span>
                            </span>
                            <span class="section-v2__article-meta">
                              <time
                                datetime={material.data.updatedAt!.toISOString()}
                              >
                                {dateFormatter.format(material.data.updatedAt!)}
                              </time>
                              <span aria-hidden="true">→</span>
                            </span>
                          </a>
                        ))
                      ) : (
                        <p class="section-v2__empty">{sectionV2Text.emptyGroup}</p>
                      )}
                    </div>
                  </details>
                ))}

                {ungroupedMaterials.length > 0 && (
                  <details
                    class="section-v2__group section-v2__group--other"
                    open={visibleGroups.length === 0}
                  >
                    <summary>
                      <span class="section-v2__number" aria-hidden="true">
                        {String(visibleGroups.length + 1).padStart(2, '0')}
                      </span>
                      <span class="section-v2__group-copy">
                        <strong>
                          {section === 'parents'
                            ? sectionV2Text.otherParent
                            : sectionV2Text.otherGeneral}
                        </strong>
                        <span>
                          {section === 'parents'
                            ? sectionV2Text.otherParentDescription
                            : sectionV2Text.otherGeneralDescription}
                        </span>
                      </span>
                      <span class="section-v2__group-count">
                        {ungroupedMaterials.length}{' '}
                        {sectionV2Text.resourceWord(ungroupedMaterials.length)}
                      </span>
                      <span
                        class="section-v2__chevron"
                        aria-hidden="true"
                      ></span>
                    </summary>

                    <div class="section-v2__article-list">
                      {ungroupedMaterials.map((material, materialIndex) => (
                        <a
                          class:list={[
                              'section-v2__article-row',
                              material.data.featuredImage && 'section-v2__article-row--image',
                            ]}
                          href={articlePath(
                            locale,
                            section,
                            material.data.slug,
                          )}
                        >
                          <span
                            class="section-v2__article-index"
                            aria-hidden="true"
                          >
                            {String(materialIndex + 1).padStart(2, '0')}
                          </span>
                          {material.data.featuredImage && (
                            <img
                              class="section-v2__article-thumb"
                              src={material.data.featuredImage}
                              alt=""
                              loading="lazy"
                              decoding="async"
                              width="96"
                              height="72"
                            />
                          )}
                          <span class="section-v2__article-copy">
                            <strong>{material.data.title}</strong>
                            <span>{material.data.summary}</span>
                          </span>
                          <span class="section-v2__article-meta">
                            <time
                              datetime={material.data.updatedAt!.toISOString()}
                            >
                              {dateFormatter.format(material.data.updatedAt!)}
                            </time>
                            <span aria-hidden="true">→</span>
                          </span>
                        </a>
                      ))}
                    </div>
                  </details>
                )}
              </div>
            )}

            {section !== 'parents' && (
              <section
                class:list={[
                  'section-v2__topic-map-section',
                  materials.length === 0 &&
                    'section-v2__topic-map-section--primary',
                ]}
                aria-labelledby="section-v2-topic-map-title"
              >
                <div class="section-v2__topic-map-heading">
                  <p class="section-v2__eyebrow">{sectionV2Text.structure}</p>
                  <h2 id="section-v2-topic-map-title">{sectionV2Text.primaryTopics}</h2>
                </div>

                <div class="section-v2__topic-map">
                  {sectionCopy.topics.map((topic, index) => (
                    <article class="section-v2__topic-card" id={topic.id}>
                      <span
                        class="section-v2__topic-number"
                        aria-hidden="true"
                      >
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <div>
                        <h3>{topic.title}</h3>
                        <p>{topic.description}</p>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            )}

            {materials.length === 0 && (
              <aside
                class="section-v2__status"
                aria-labelledby="section-v2-status-title"
              >
                <span class="section-v2__status-mark" aria-hidden="true"></span>
                <div>
                  <h2 id="section-v2-status-title">{copy.sectionStatus}</h2>
                  <p>{copy.sectionStatusText}</p>
                </div>
              </aside>
            )}

            <a class="section-v2__back" href={localePath(locale)}>
              ← {copy.backHome}
            </a>
          </div>
        </section>
      </article>
    ) : (
      <article class="content-page">
        <header class="content-page__header">
          <div class="container content-page__inner">
            <p class="breadcrumb">
              <a href={localePath(locale)}>{copy.homeLabel}</a>
              <span aria-hidden="true"> / </span>
              <span aria-current="page">{sectionCopy.title}</span>
            </p>
            <p class="eyebrow">{SITE.name}</p>
            <h1>{sectionCopy.title}</h1>
            <p class="content-page__description">{sectionCopy.description}</p>
          </div>
        </header>

        {materials.length > 0 && (
          <section class="materials-section" aria-labelledby="materials-title">
            <div class="container">
              <div class="section-intro">
                <h2 id="materials-title">{contentCopy.materialsTitle}</h2>
                <p>{contentCopy.materialsText}</p>
              </div>
              <div class="materials-grid">
                {materials.map((material) => (
                  <ArticleCard
                    href={articlePath(locale, section, material.data.slug)}
                    title={material.data.title}
                    summary={material.data.summary}
                    publishedAt={material.data.publishedAt!}
                    locale={locale}
                  />
                ))}
              </div>
            </div>
          </section>
        )}

        <section class="topic-section" aria-labelledby="topics-title">
          <div class="container">
            <div class="section-intro section-intro--top">
              <h2 id="topics-title">{copy.topicsTitle}</h2>
              <p>{copy.topicsText}</p>
            </div>

            <div class="topic-grid">
              {sectionCopy.topics.map((topic, index) => (
                <article class="topic-card" id={topic.id}>
                  <span class="topic-card__number" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <h3>{topic.title}</h3>
                  <p>{topic.description}</p>
                </article>
              ))}
            </div>

            {materials.length === 0 && (
              <aside
                class="status-panel status-panel--section"
                aria-labelledby="section-status-title"
              >
                <span class="status-panel__mark" aria-hidden="true"></span>
                <div>
                  <h2 id="section-status-title">{copy.sectionStatus}</h2>
                  <p>{copy.sectionStatusText}</p>
                </div>
              </aside>
            )}

            <a class="back-link" href={localePath(locale)}>
              ← {copy.backHome}
            </a>
          </div>
        </section>
      </article>
    )
  }
</BaseLayout>
