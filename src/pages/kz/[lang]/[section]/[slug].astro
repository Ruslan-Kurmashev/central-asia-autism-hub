---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../../../layouts/ArticleLayout.astro';
import type { Locale } from '../../../../site.config';

export async function getStaticPaths() {
  const pages = await getCollection(
    'pages',
    ({ data }) =>
      !data.draft &&
      data.translationStatus !== 'pending' &&
      Boolean(data.publishedAt) &&
      Boolean(data.updatedAt),
  );

  const research = await getCollection(
    'research',
    ({ data }) =>
      !data.draft &&
      data.translationStatus !== 'pending' &&
      Boolean(data.publishedAt) &&
      Boolean(data.updatedAt),
  );

  const entries = [...pages, ...research];

  // Display the earliest recorded publication date for every language version
  // of the same article. Keep each file's publishedAt and updatedAt unchanged.
  const firstPublicationDates = new Map<string, Date>();
  for (const item of entries) {
    const firstDate = item.data.originalPublishedAt ?? item.data.publishedAt;
    if (!firstDate) continue;
    const previous = firstPublicationDates.get(item.data.translationKey);
    if (!previous || firstDate.getTime() < previous.getTime()) {
      firstPublicationDates.set(item.data.translationKey, firstDate);
    }
  }

  const routeIds = new Set<string>();

  for (const entry of entries) {
    const routeId = `${entry.data.language}/${entry.data.section}/${entry.data.slug}`;
    if (routeIds.has(routeId)) {
      throw new Error(`Duplicate published material route: ${routeId}`);
    }
    routeIds.add(routeId);
  }

  return Promise.all(
    entries.map(async (entry) => {
      const translations = entries.filter(
        (candidate) => candidate.data.translationKey === entry.data.translationKey,
      );
      const firstPublishedAt = firstPublicationDates.get(entry.data.translationKey);
      if (!firstPublishedAt) {
        throw new Error(`Missing first publication date for ${entry.data.translationKey}`);
      }
      const alternatePaths = Object.fromEntries(
        translations.map((translation) => [
          translation.data.language,
          `${translation.data.section}/${translation.data.slug}`,
        ]),
      ) as Partial<Record<Locale, string>>;

      const sameTopic = entries
        .filter(
          (candidate) =>
            candidate.data.language === entry.data.language &&
            candidate.data.section === entry.data.section &&
            candidate.data.topic === entry.data.topic &&
            candidate.data.slug !== entry.data.slug,
        )
        .sort((left, right) =>
          left.data.title.localeCompare(right.data.title, entry.data.language),
        );

      const nextEntry = sameTopic.find(
        (candidate) =>
          candidate.data.title.localeCompare(
            entry.data.title,
            entry.data.language,
          ) > 0,
      ) ?? sameTopic[0];

      return {
        params: {
          lang: entry.data.language,
          section: entry.data.section,
          slug: entry.data.slug,
        },
        props: { entry, alternatePaths, nextEntry, firstPublishedAt },
      };
    }),
  );
}

interface Props {
  entry: CollectionEntry<'pages'> | CollectionEntry<'research'>;
  alternatePaths: Partial<Record<Locale, string>>;
  nextEntry?: CollectionEntry<'pages'> | CollectionEntry<'research'>;
  firstPublishedAt: Date;
}

const { entry, alternatePaths, nextEntry, firstPublishedAt } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout
  entry={entry}
  alternatePaths={alternatePaths}
  headings={headings}
  nextEntry={nextEntry}
  firstPublishedAt={firstPublishedAt}
>
  <Content />
</ArticleLayout>
