---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { articlePath, localePath } from '../../../../lib/urls';
import { SUPPORTED_LOCALES, SITE, type Locale } from '../../../../site.config';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}
interface Props { lang: Locale }
const { lang } = Astro.props;
const content = {
  ru: { title:'Скрининг развития: предварительный просмотр', subtitle:'Макет будущего M-CHAT-R/F на AutismHub. Это не действующий тест.', tag:'Демо · лицензия ожидается', stages:['Подготовка','Вопросы','Результат и PDF'], start:'Перед началом',intro:'Для реального M-CHAT-R/F предусмотрены 20 вопросов и, при определённых результатах, уточняющее интервью Follow-Up. Инструмент предназначен для родителей детей 16–30 месяцев.', rights:'Для размещения электронной версии опросника требуется разрешение правообладателей. Пока вопросы и подсчёт баллов недоступны.', privacy:'Запланировано использование без регистрации и отправки ответов на сервер. PDF должен содержать только результат, не вопросы или ответы.', question:'Здесь появится официально разрешённый текст вопроса', questionNote:'Это только пример расположения элементов. Отвечать на него нельзя.', yes:'Да',no:'Нет', resultTitle:'Образец итогового листа', resultText:'Это демонстрация. Тест не проходился и результат не рассчитывался.', outcome:'Итог',outcomeValue:'Не определён',score:'Баллы',scoreValue:'Не рассчитывались',follow:'Follow-Up',followValue:'Не проводился', nextStep:'Дальнейшие действия',advice:'Если развитие ребёнка вызывает вопросы, обратитесь к специалисту независимо от результата скрининга. Опросник не устанавливает и не исключает диагноз.', date:'Дата образца', stamp:'ДЕМО · НЕ МЕДИЦИНСКИЙ РЕЗУЛЬТАТ', next:'Следующий экран',back:'Назад',toResult:'Посмотреть результат',print:'Сохранить в PDF / распечатать',printHelp:'В окне печати выберите «Сохранить как PDF». Печатается только итог, без вопросов и ответов.',source:'Условия правообладателей',article:'К статье о развитии ребёнка'},
  kk: { title:'Даму скринингі: алдын ала үлгі',subtitle:'AutismHub-тағы болашақ M-CHAT-R/F интерфейсінің үлгісі. Бұл нақты тест емес.',tag:'Үлгі · лицензия күтілуде',stages:['Дайындық','Сұрақтар','Нәтиже және PDF'],start:'Бастамас бұрын',intro:'M-CHAT-R/F сауалнамасында 20 сұрақ және кейбір нәтижелер үшін Follow-Up сұхбаты бар. Ол 16–30 айлық балалардың ата-аналарына арналған.',rights:'Электрондық сауалнаманы жариялауға құқық иелерінің рұқсаты қажет. Әзірге сұрақтар мен ұпай есептеу қолжетімсіз.',privacy:'Тіркеусіз, жауаптарды серверге жібермей пайдалану жоспарланған. PDF ішінде тек қорытынды болады, сұрақтар мен жауаптар болмайды.',question:'Бұл жерде рұқсат етілген сұрақ мәтіні болады',questionNote:'Бұл тек интерфейс үлгісі. Жауап беруге болмайды.',yes:'Иә',no:'Жоқ',resultTitle:'Қорытынды парақтың үлгісі',resultText:'Бұл тек үлгі. Тест өткізілмеген, нәтиже есептелмеген.',outcome:'Қорытынды',outcomeValue:'Анықталмаған',score:'Ұпай',scoreValue:'Есептелмеген',follow:'Follow-Up',followValue:'Өткізілмеген',nextStep:'Келесі қадамдар',advice:'Баланың дамуына қатысты алаңдаушылық болса, нәтижеге қарамастан маманға жүгініңіз. Сауалнама диагнозды растамайды да, жоққа шығармайды да.',date:'Үлгі күні',stamp:'ҮЛГІ · МЕДИЦИНАЛЫҚ НӘТИЖЕ ЕМЕС',next:'Келесі экран',back:'Артқа',toResult:'Нәтижені көру',print:'PDF ретінде сақтау / басып шығару',printHelp:'Басып шығару терезесінде PDF ретінде сақтауды таңдаңыз. Тек қорытынды сақталады.',source:'Құқық иелерінің шарттары',article:'Баланың дамуы туралы мақала'},
  en: {title:'Developmental screening: interface preview',subtitle:'Preview the future M-CHAT-R/F experience on AutismHub. This is not an active questionnaire.',tag:'Preview · licence pending',stages:['Preparation','Questions','Result and PDF'],start:'Before you begin',intro:'M-CHAT-R/F includes 20 initial questions and a Follow-Up interview for certain outcomes. It is intended for parents of children aged 16–30 months.',rights:'The rightsholders require a licence for an electronic version. Questions and scoring are disabled until permission is granted.',privacy:'The plan is to avoid accounts and server uploads. The PDF will contain only the result, not questions or individual answers.',question:'Authorised question text will appear here',questionNote:'This is only an interface illustration. It cannot be answered.',yes:'Yes',no:'No',resultTitle:'Sample result summary',resultText:'This is a preview. No questionnaire was completed or scored.',outcome:'Outcome',outcomeValue:'Not available',score:'Score',scoreValue:'Not calculated',follow:'Follow-Up',followValue:'Not administered',nextStep:'Next steps',advice:'Discuss any concerns about a child’s development with a qualified professional regardless of a screening score. Screening cannot diagnose or rule out autism.',date:'Sample date',stamp:'PREVIEW · NOT A CLINICAL RESULT',next:'Next screen',back:'Back',toResult:'Preview result',print:'Save as PDF / print',printHelp:'Choose Save as PDF in the browser print dialog. Only the result page is printed.',source:'Rightsholder permission rules',article:'Read the child development article'}
} as const;
const c = content[lang];
const articleSlugs: Record<Locale,string> = {ru:'kogda-obsudit-razvitie-rebenka-so-specialistom',kk:'balanyn-damuyn-mamanmen-kashan-talkylau',en:'when-to-discuss-child-development'};
const alternatePaths = Object.fromEntries(SUPPORTED_LOCALES.map((locale) => [locale, 'tools/mchat-preview'])) as Record<Locale,string>;
---
<BaseLayout title={c.title+' | '+SITE.name} description={c.subtitle} locale={lang} currentSection="parents" alternatePath="tools/mchat-preview" alternatePaths={alternatePaths} bodyClass="mchat-preview-page">
  <div class="mchat-demo" data-mchat-demo data-locale={lang}>
    <div class="mchat-demo__hero"><div class="mchat-demo__wrap">
      <a href={articlePath(lang,'parents',articleSlugs[lang])}>{c.article}</a>
      <p class="mchat-demo__eyebrow">AUTISM HUB KAZAKHSTAN · M-CHAT-R/F</p>
      <h1>{c.title}</h1><p class="mchat-demo__lead">{c.subtitle}</p><span class="mchat-demo__badge">{c.tag}</span>
    </div></div>
    <div class="mchat-demo__wrap mchat-demo__body">
      <aside class="mchat-demo__aside">
        <nav aria-label="Language" class="mchat-demo__languages">
          {SUPPORTED_LOCALES.map((code)=><a href={localePath(code,'tools/mchat-preview')} aria-current={code===lang?'page':undefined}>{code.toUpperCase()}</a>)}
        </nav>
        <ol class="mchat-demo__steps">{c.stages.map((stage,i)=><li data-step={i} class={i===0?'active':''}><span>{i+1}</span>{stage}</li>)}</ol>
        <a href="https://www.mchatscreen.com/mchat-rf/" target="_blank" rel="noopener noreferrer">{c.source}</a>
      </aside>
      <div class="mchat-demo__main">
        <section class="mchat-demo__card" data-panel="0"><p class="mchat-demo__small">01 / 03</p><h2>{c.start}</h2><p>{c.intro}</p>
          <div class="mchat-demo__info"><h3>{c.tag}</h3><p>{c.rights}</p></div>
          <div class="mchat-demo__info"><h3>Privacy / Құпиялық / Конфиденциальность</h3><p>{c.privacy}</p></div>
          <div class="mchat-demo__actions"><button type="button" data-show="1">{c.next} →</button></div>
        </section>
        <section class="mchat-demo__card" data-panel="1" hidden><p class="mchat-demo__small">02 / 03 · 1 / 20</p><div class="mchat-demo__progress"><span></span></div>
          <h2>{c.question}</h2><p>{c.questionNote}</p>
          <div class="mchat-demo__answers" aria-hidden="true"><span>○ &nbsp;{c.yes}</span><span>○ &nbsp;{c.no}</span></div>
          <div class="mchat-demo__actions"><button type="button" class="secondary" data-show="0">{c.back}</button><button type="button" data-show="2">{c.toResult} →</button></div>
        </section>
        <section class="mchat-demo__card" data-panel="2" hidden><p class="mchat-demo__small">03 / 03</p><h2>{c.resultTitle}</h2><p>{c.resultText}</p>
          <div class="mchat-demo__summary"><p>{c.outcome}</p><h3>{c.outcomeValue}</h3>
            <dl><div><dt>{c.score}</dt><dd>{c.scoreValue}</dd></div><div><dt>{c.follow}</dt><dd>{c.followValue}</dd></div><div><dt>{c.nextStep}</dt><dd>{c.advice}</dd></div></dl>
          </div>
          <div class="mchat-demo__actions"><button type="button" class="secondary" data-show="1">{c.back}</button><button type="button" data-print>{c.print}</button></div><p class="mchat-demo__small">{c.printHelp}</p>
        </section>
      </div>
    </div>
    <section class="mchat-demo__print"><p>AUTISM HUB KAZAKHSTAN · M-CHAT-R/F</p><h1>{c.resultTitle}</h1><p class="mchat-demo__stamp">{c.stamp}</p>
      <dl><div><dt>{c.date}</dt><dd data-date>—</dd></div><div><dt>{c.outcome}</dt><dd>{c.outcomeValue}</dd></div><div><dt>{c.score}</dt><dd>{c.scoreValue}</dd></div><div><dt>{c.follow}</dt><dd>{c.followValue}</dd></div></dl>
      <h2>{c.nextStep}</h2><p>{c.advice}</p><p class="mchat-demo__small">{c.resultText}</p>
    </section>
  </div>
</BaseLayout>
<style>
.mchat-demo{background:var(--color-background);min-width:0}.mchat-demo__wrap{width:min(calc(100% - 2rem),var(--content-width));margin:auto}
.mchat-demo__hero{background:linear-gradient(115deg,#112b4c,#28608a);color:#fff;padding:2rem 0 2.7rem}.mchat-demo__hero a{color:#e5f2ff;font-size:var(--type-small)}.mchat-demo__eyebrow{font-size:var(--type-small);color:#c1dbef;font-weight:700;margin:1.5rem 0 .65rem;letter-spacing:.07em}.mchat-demo__hero h1{color:white;max-width:24ch}.mchat-demo__lead{font-size:var(--type-lead);max-width:62ch;margin:.9rem 0 1.3rem;color:#e5f0fb}.mchat-demo__badge{background:#e7f1fc;color:#18436f;padding:.4rem .85rem;display:inline-block;border-radius:2rem;font-weight:700;font-size:var(--type-small)}
.mchat-demo__body{display:grid;grid-template-columns:minmax(12rem,16rem) minmax(0,1fr);gap:2rem;align-items:start;padding:2rem 0 4rem}
.mchat-demo__aside{display:grid;gap:1.3rem;font-size:var(--type-small)}.mchat-demo__languages{display:flex;gap:.4rem;flex-wrap:wrap}.mchat-demo__languages a{background:#fff;border:1px solid #bfd0e0;border-radius:.5rem;padding:.35rem .65rem;text-decoration:none;font-weight:700}.mchat-demo__languages [aria-current=page]{background:#225b96;color:#fff}
.mchat-demo__steps{margin:0;padding:0;list-style:none;display:grid;gap:.3rem}.mchat-demo__steps li{display:flex;align-items:center;gap:.7rem;padding:.75rem;border-left:3px solid transparent}.mchat-demo__steps li.active{background:#e5f0fb;border-left-color:#225b96;border-radius:.3rem;color:#18436f;font-weight:700}.mchat-demo__steps span{display:grid;place-items:center;flex:none;width:2rem;height:2rem;border:1px solid #bdcede;border-radius:50%}
.mchat-demo__card{padding:clamp(1.1rem,3vw,2.5rem);display:grid;gap:1.1rem;background:#fff;border:1px solid #d3e0ed;border-radius:1rem;box-shadow:0 12px 38px #182a3e12}.mchat-demo__card[hidden]{display:none}.mchat-demo__card h2{max-width:none}.mchat-demo__card p{color:#52667b}.mchat-demo__small{font-size:var(--type-small)}.mchat-demo__info{background:#eff5fb;padding:1rem;border-radius:.7rem}.mchat-demo__info h3{font-size:var(--type-subhead);margin-bottom:.4rem}.mchat-demo__answers{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.mchat-demo__answers span{padding:1rem;border:1px dashed #afc5d9;border-radius:.6rem;color:#52667b}.mchat-demo__progress{height:.45rem;background:#dbe8f3;border-radius:1rem;overflow:hidden}.mchat-demo__progress span{display:block;background:#245e99;width:5%;height:100%}
.mchat-demo__summary{padding:1.2rem;background:#eef5fb;border-radius:.75rem}.mchat-demo__summary h3{margin:.2rem 0 1rem;font-size:var(--type-h3)}.mchat-demo__summary dl{display:grid;gap:.6rem;margin:0}.mchat-demo__summary dl div,.mchat-demo__print dl div{display:grid;grid-template-columns:minmax(7rem,35%) minmax(0,1fr);gap:1rem;border-top:1px solid #d1dfec;padding:.6rem 0}.mchat-demo__summary dd,.mchat-demo__print dd{margin:0;font-weight:650}
.mchat-demo__actions{display:flex;gap:.75rem;justify-content:space-between;flex-wrap:wrap}.mchat-demo__actions button{min-height:2.9rem;border:1px solid #225b96;background:#225b96;color:white;padding:.65rem 1rem;border-radius:.5rem;font-size:var(--type-control);font-weight:700;cursor:pointer}.mchat-demo__actions button:not(.secondary){margin-left:auto}.mchat-demo__actions button:hover{background:#194a7a}.mchat-demo__actions .secondary{background:white;color:#225b96}.mchat-demo__print{display:none}
@media(max-width:52rem){.mchat-demo__body{grid-template-columns:1fr}.mchat-demo__steps{grid-template-columns:repeat(3,minmax(0,1fr))}.mchat-demo__steps li{flex-direction:column;align-items:start;border-left:0;border-bottom:3px solid transparent;font-size:var(--type-small)}.mchat-demo__steps li.active{border-left:0;border-bottom-color:#225b96}}
@media(max-width:32rem){.mchat-demo__answers{grid-template-columns:1fr}.mchat-demo__summary dl div{grid-template-columns:1fr;gap:0}.mchat-demo__actions{flex-direction:column-reverse}.mchat-demo__actions button{width:100%}}
@media print{@page{size:A4;margin:18mm}:global(.mchat-preview-page .site-header),:global(.mchat-preview-page .site-footer),:global(.mchat-preview-page .skip-link){display:none!important}.mchat-demo__hero,.mchat-demo__body{display:none!important}.mchat-demo__print{display:block!important;background:white;font-size:var(--type-print-body)}.mchat-demo__print h1{max-width:none;font-size:var(--type-print-h1)}.mchat-demo__print h2{font-size:var(--type-print-h2);margin:1.5rem 0 .5rem}.mchat-demo__print dl{margin:1.5rem 0}.mchat-demo__stamp{border:1px solid #64748b;padding:.4rem;display:inline-block}}
</style>
<script>
document.querySelectorAll<HTMLElement>('[data-mchat-demo]').forEach(root=>{
 const panels=Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
 const steps=Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));
 root.querySelectorAll<HTMLButtonElement>('[data-show]').forEach(button=>button.addEventListener('click',()=>{
  const n=Number(button.dataset.show);if(!Number.isInteger(n)||n<0||n>=panels.length)return;
  panels.forEach((panel,i)=>{panel.hidden=i!==n});
  steps.forEach((step,i)=>step.classList.toggle('active',i===n));
  const h=panels[n].querySelector<HTMLElement>('h2');if(h){h.tabIndex=-1;h.focus({preventScroll:true})}
 }));
 root.querySelector<HTMLButtonElement>('[data-print]')?.addEventListener('click',()=>{
  const locale=root.dataset.locale==='kk'?'kk-KZ':root.dataset.locale==='en'?'en-GB':'ru-RU';
  const date=root.querySelector<HTMLElement>('[data-date]');if(date)date.textContent=new Intl.DateTimeFormat(locale,{day:'numeric',month:'long',year:'numeric'}).format(new Date());
  window.print();
 });
});
</script>