---
import { getCollection } from 'astro:content';
import SectionCard from '../../../components/SectionCard.astro';
import HomepageAnnouncements from '../../../components/HomepageAnnouncements.astro';
import { getEditorialVisual } from '../../../data/editorial-visuals';
import { getResearchCardVisual } from '../../../data/research-card-visuals';
import { CONTENT_UI, DATE_LOCALES } from '../../../i18n/content';
import { UI } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { articlePath, sectionPath } from '../../../lib/urls';
import {
  SITE,
  SUPPORTED_LOCALES,
  type Locale,
  type Section,
} from '../../../site.config';
import '../../../styles/home-v2.css';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { lang: locale },
    props: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = UI[locale];
const [sloganFirstLine, sloganSecondLine] = copy.title.split(/(?<=,)\s+/);
const contentCopy = CONTENT_UI[locale];
const useHomeV2 = ['ru', 'en', 'kk'].includes(locale);

const legacyHomeSections: Array<{
  section: Section;
  variant: 'large' | 'medium' | 'compact';
  tone: 'parents' | 'help' | 'research' | 'learning' | 'neutral';
}> = [
  { section: 'parents', variant: 'large', tone: 'parents' },
  { section: 'help-kazakhstan', variant: 'large', tone: 'help' },
  { section: 'research', variant: 'medium', tone: 'research' },
  { section: 'learning', variant: 'medium', tone: 'learning' },
  { section: 'professionals', variant: 'compact', tone: 'neutral' },
  { section: 'about', variant: 'compact', tone: 'neutral' },
];

const parentsPath = sectionPath(locale, 'parents');
const quickSections: Section[] = ['parents', 'help-kazakhstan', 'research'];
const heroImagePath = `${import.meta.env.BASE_URL}images/hero-family.webp`;
const homeHeroBannerPath = `${import.meta.env.BASE_URL}images/home-hero-family-2026.webp`;

const publishedPages = (
  await getCollection(
    'pages',
    ({ data }) =>
      !data.draft &&
      data.language === locale &&
      data.translationStatus !== 'pending' &&
      Boolean(data.publishedAt),
  )
).sort(
  (left, right) =>
    (right.data.publishedAt?.getTime() ?? 0) -
    (left.data.publishedAt?.getTime() ?? 0),
);

// The family-first landing page must not be taken over by a batch of newly
// published professional legal documents. Keep useful, reviewed resources from
// families, Kazakhstan services and research visible together.
const publishedResearch = (await getCollection(
  'research',
  ({ data }) =>
    !data.draft &&
    data.language === locale &&
    data.translationStatus !== 'pending' &&
    Boolean(data.publishedAt),
)).sort(
  (left, right) =>
    (right.data.publishedAt?.getTime() ?? 0) -
    (left.data.publishedAt?.getTime() ?? 0),
);
// Select recent published articles from different sections to avoid dominance
// by large batches of professional documents or parent materials.
const recentCandidates = [
  ...publishedPages.filter((entry) => entry.data.section !== 'about'),
  ...publishedResearch,
].sort((a, b) =>
  (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
);
const prioritySections: Section[] = [
  'parents', 'help-kazakhstan', 'research', 'learning', 'professionals',
];
const featuredUpdates = prioritySections
  .map((section) => recentCandidates.find((entry) =>
    entry.data.section === section && (section !== 'research' || entry.collection === 'research'),
  ))
  .filter((entry): entry is (typeof recentCandidates)[number] => Boolean(entry));
const includedUpdates = new Set(featuredUpdates.map((entry) => entry.collection + ':' + entry.id));
const extraUpdates = recentCandidates.filter((entry) =>
  !includedUpdates.has(entry.collection + ':' + entry.id) &&
  entry.data.section !== 'research' && entry.data.section !== 'professionals',
).slice(0, Math.max(0, 6 - featuredUpdates.length));
const homeMaterials = [...featuredUpdates, ...extraUpdates]
  .sort((a, b) =>
    (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
  )
  .slice(0, 6);
const homeV2Labels = locale === 'en'
  ? {
      latestKicker: 'PLATFORM UPDATES',
      latestTitle: 'Latest on AutismHub',
      latestLead: 'Newly published articles across our main information sections.',
      sourcesHeading: 'What our materials are based on',
      sourceCards: [
        { title: 'Scientific publications', description: 'Research studies, systematic reviews and evidence-based findings.' },
        { title: 'Clinical guidance', description: 'International guidelines, standards of care and professional approaches.' },
        { title: 'Official sources', description: 'Documents from government bodies and international organisations.' },
        { title: 'Resources for families', description: 'Clear explanations, practical materials and guidance on finding support.' },
      ],
    }
  : locale === 'kk'
    ? {
        latestKicker: 'ПЛАТФОРМА ЖАҢАЛЫҚТАРЫ',
        latestTitle: 'AutismHub-тағы жаңалықтар',
        latestLead: 'Сайттың әртүрлі бөлімдерінде жақында жарияланған мақалалар мен материалдар.',
        sourcesHeading: 'Материалдарымыз неге негізделеді',
        sourceCards: [
          { title: 'Ғылыми жарияланымдар', description: 'Зерттеулер, жүйелі шолулар және дәлелді медицина деректері.' },
          { title: 'Клиникалық ұсынымдар', description: 'Халықаралық нұсқаулықтар, көмек көрсету стандарттары және кәсіби тәсілдер.' },
          { title: 'Ресми дереккөздер', description: 'Мемлекеттік органдар мен халықаралық ұйымдардың құжаттары.' },
          { title: 'Отбасыларға арналған материалдар', description: 'Түсінікті түсіндірмелер, практикалық материалдар және қолдау табуға арналған ақпарат.' },
        ],
      }
    : {
        latestKicker: 'ОБНОВЛЕНИЯ ПЛАТФОРМЫ',
        latestTitle: 'Новое на AutismHub',
        latestLead: 'Недавно опубликованные статьи и материалы из разных разделов платформы.',
        sourcesHeading: 'На чём основаны наши материалы',
        sourceCards: [
          { title: 'Научные публикации', description: 'Исследования, систематические обзоры и данные доказательной медицины.' },
          { title: 'Клинические рекомендации', description: 'Международные руководства, стандарты помощи и профессиональные подходы.' },
          { title: 'Официальные источники', description: 'Документы государственных и международных организаций.' },
          { title: 'Материалы для семей', description: 'Понятные объяснения, практические материалы и навигация по теме.' },
        ],
      };
const usedEditorialImages = new Set<string>();
const homeCards = homeMaterials.map((material, index) => {
  // Research figures retain their primary-study credit inside each article.
  // The homepage uses an article-specific self-hosted, licensed editorial image
  // to prevent duplicate generic laboratory thumbnails.
  if (material.collection === 'research') {
    const researchVisual = getResearchCardVisual(material.data.slug);
    if (!researchVisual) {
      throw new Error('Missing distinct research-card image for: ' + material.data.slug);
    }
    return {
      material,
      cardImage: `${import.meta.env.BASE_URL}${researchVisual.src}`,
      cardImageAlt: researchVisual.alt,
    };
  }
  if (material.data.featuredImage) {
    return {
      material,
      cardImage: material.data.featuredImage,
      cardImageAlt: material.data.featuredImageAlt ?? '',
    };
  }

  const curated = getEditorialVisual(
    material.data.section,
    material.data.topic,
    material.data.title,
  );

  if (curated && !usedEditorialImages.has(curated.src)) {
    usedEditorialImages.add(curated.src);
    return {
      material,
      cardImage: `${import.meta.env.BASE_URL}${curated.src}`,
      cardImageAlt: locale === 'en'
        ? 'Learning and information materials on a table.'
        : locale === 'kk'
          ? 'Үстелдегі оқу және ақпараттық материалдар.'
          : curated.alt,
    };
  }

  if (index === 0) {
    return {
      material,
      cardImage: heroImagePath,
      cardImageAlt: copy.heroImageAlt,
    };
  }

  return {
    material,
    cardImage: heroImagePath,
    cardImageAlt: copy.heroImageAlt,
  };
});
const featuredMaterials = publishedPages
  .filter((entry) => entry.data.section === 'parents')
  .slice(0, 3);

const dateFormatter = new Intl.DateTimeFormat(DATE_LOCALES[locale], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={`${SITE.name} - ${copy.eyebrow}`}
  description={copy.lead}
  locale={locale}
  bodyClass={useHomeV2 ? 'home-v2' : undefined}
>
  {
    useHomeV2 ? (
      <>
        <section class="home-v2__hero" aria-labelledby="home-v2-title">
          <img
            class="home-v2__hero-image"
            src={homeHeroBannerPath}
            alt={copy.heroImageAlt}
            width="1600"
            height="533"
            decoding="async"
            fetchpriority="high"
          />
          <div class="home-v2__hero-overlay" aria-hidden="true"></div>

          <div class="container home-v2__hero-content">
            <p class="home-v2__eyebrow">{copy.eyebrow}</p>
            <h1 id="home-v2-title">
              <span class="home-v2__hero-title-line">{sloganFirstLine}</span>
              <span class="home-v2__hero-title-line home-v2__hero-title-line--supporting">{sloganSecondLine}</span>
            </h1>
            <p class="home-v2__lead">{copy.lead}</p>
            <a
              class="home-v2__hero-button"
              href={`${parentsPath}#autism-basics`}
            >
              {copy.heroPrimaryAction}
            </a>
          </div>
        </section>

        <div class="home-v2__content">
          <HomepageAnnouncements locale={locale} />
          <section
            id="materials"
            class="home-v2__materials"
            aria-labelledby="home-v2-materials-title"
          >
            <div class="container">
              <div class="home-v2__materials-heading">
                <div>
                  <p class="home-v2__kicker">{homeV2Labels.latestKicker}</p>
                  <h2 id="home-v2-materials-title">{homeV2Labels.latestTitle}</h2>
                  <p class="home-v2__materials-description">{homeV2Labels.latestLead}</p>
                </div>
              </div>

              <div class="home-v2__masonry">
                {homeCards.map(({ material, cardImage, cardImageAlt }, index) => {
                  return (
                    <article
                      class:list={[
                        'home-v2__card',
                        'home-v2__card--article',
                        cardImage && 'home-v2__card--image',
                      ]}
                    >
                      {cardImage && (
                        <img
                          src={cardImage}
                          alt={cardImageAlt}
                          width="900"
                          height="540"
                          loading="lazy"
                          decoding="async"
                        />
                      )}

                      <div class="home-v2__card-body">
                        <span class="home-v2__card-tag">
                          {copy.sections[material.data.section].title}
                        </span>
                        <h3>
                          <a
                            href={articlePath(
                              locale,
                              material.data.section,
                              material.data.slug,
                            )}
                          >
                            {material.data.title}
                          </a>
                        </h3>
                        <p>{material.data.summary}</p>
                        <div class="home-v2__card-meta">
                          <time datetime={material.data.publishedAt!.toISOString()}>
                            {dateFormatter.format(material.data.publishedAt!)}
                          </time>
                          <span aria-hidden="true">→</span>
                        </div>
                      </div>
                    </article>
                  );
                })}

              </div>
            </div>
          </section>

          <section class="home-v2__sources" aria-labelledby="home-v2-sources-title">
            <div class="container">
              <h2 id="home-v2-sources-title">{homeV2Labels.sourcesHeading}</h2>
              <ul class="home-v2__source-grid" aria-label={homeV2Labels.sourcesHeading}>
                {homeV2Labels.sourceCards.map((card, index) => (
                  <li class="home-v2__source-card">
                    <span class="home-v2__source-icon" aria-hidden="true">
                      {index === 0 ? (
                        <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M17 8h23l11 11v33a4 4 0 0 1-4 4H17a4 4 0 0 1-4-4V12a4 4 0 0 1 4-4Z"/>
                          <path d="M40 8v12h11M22 29h20M22 37h20M22 45h14"/>
                        </svg>
                      ) : index === 1 ? (
                        <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="14" y="8" width="37" height="48" rx="5"/>
                          <path d="m21 22 3 3 5-6m5 4h10M21 36l3 3 5-6m5 4h10M21 49l3 3 5-6m5 4h10"/>
                        </svg>
                      ) : index === 2 ? (
                        <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M32 6 52 14v17c0 12-8 21-20 27C20 52 12 43 12 31V14L32 6Z"/>
                          <circle cx="32" cy="31" r="13"/>
                          <path d="m25 31 5 5 10-11"/>
                        </svg>
                      ) : (
                        <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="32" cy="28" r="7"/>
                          <circle cx="14" cy="35" r="6"/>
                          <circle cx="50" cy="35" r="6"/>
                          <path d="M20 54v-3c0-7 5-12 12-12s12 5 12 12v3M3 55v-4c0-6 4-10 11-10 3 0 6 1 8 4M61 55v-4c0-6-4-10-11-10-3 0-6 1-8 4"/>
                          <path class="home-v2__icon-accent" d="M26 11c0-3 2-5 5-5 2 0 3 1 4 3 1-2 3-3 5-3 3 0 5 2 5 5 0 4-5 8-10 12-5-4-9-8-9-12Z"/>
                        </svg>
                      )}
                    </span>
                    <h3>{card.title}</h3>
                    <p>{card.description}</p>
                  </li>
                ))}
              </ul>
              <p class="home-v2__source-note">{copy.principlesBoundary}</p>
            </div>
          </section>
        </div>
      </>
    ) : (
      <>
        <div class="beta-strip" role="status">
          <div class="container beta-strip__inner">
            <strong>{copy.statusTitle}</strong>
            <span>{copy.statusText}</span>
          </div>
        </div>

        <section class="hero">
          <div class="container hero__layout">
            <div class="hero__content">
              <p class="eyebrow">{copy.eyebrow}</p>
              <h1>{copy.title}</h1>
              <p class="hero__lead">{copy.lead}</p>

              <div class="hero__actions">
                <a class="button button--primary" href={`${parentsPath}#autism-basics`}>
                  {copy.heroPrimaryAction}
                </a>
                <a class="button button--secondary" href={parentsPath}>
                  {copy.heroSecondaryAction}
                </a>
                <a
                  class="hero__professional-link"
                  href={sectionPath(locale, 'professionals')}
                >
                  {copy.heroProfessionalAction} <span aria-hidden="true">→</span>
                </a>
              </div>

              <ul class="hero__points" aria-label={copy.eyebrow}>
                {copy.heroPoints.map((point) => <li>{point}</li>)}
              </ul>
            </div>

            <div class="hero__visual">
              <img
                src={heroImagePath}
                alt={copy.heroImageAlt}
                width="1801"
                height="873"
                decoding="async"
                fetchpriority="high"
              />
            </div>
          </div>
        </section>

        {featuredMaterials.length > 0 && (
          <section
            class="featured-materials"
            aria-labelledby="featured-materials-title"
          >
            <div class="container">
              <div class="featured-materials__intro">
                <div>
                  <p class="eyebrow">{copy.featuredEyebrow}</p>
                  <h2 id="featured-materials-title">{copy.featuredTitle}</h2>
                </div>
                <p>{copy.featuredText}</p>
              </div>

              <div class="featured-materials__grid">
                {featuredMaterials.map((material, index) => (
                  <article
                    class:list={[
                      'featured-material-card',
                      `featured-material-card--${index + 1}`,
                    ]}
                  >
                    <div class="featured-material-card__topline">
                      <span>
                        {index === 0 ? copy.featuredLabel : contentCopy.articleLabel}
                      </span>
                      <span aria-hidden="true">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                    </div>
                    <h3>
                      <a href={articlePath(locale, 'parents', material.data.slug)}>
                        {material.data.title}
                      </a>
                    </h3>
                    <p>{material.data.summary}</p>
                    <div class="featured-material-card__footer">
                      <time datetime={material.data.publishedAt!.toISOString()}>
                        {contentCopy.publishedLabel}:{' '}
                        {dateFormatter.format(material.data.publishedAt!)}
                      </time>
                      <span aria-hidden="true">→</span>
                    </div>
                  </article>
                ))}
              </div>

              <a class="featured-materials__all" href={parentsPath}>
                {copy.allMaterialsAction} <span aria-hidden="true">→</span>
              </a>
            </div>
          </section>
        )}

        <section class="quick-paths" aria-labelledby="quick-paths-title">
          <div class="container">
            <h2 id="quick-paths-title">{copy.quickPathsTitle}</h2>
            <nav class="quick-paths__grid" aria-label={copy.quickPathsTitle}>
              <ul>
                {quickSections.map((section, index) => (
                  <li>
                    <a href={sectionPath(locale, section)}>
                      <span class="quick-paths__number" aria-hidden="true">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span class="quick-paths__copy">
                        <strong>{copy.sections[section].title}</strong>
                        <span>{copy.sections[section].description}</span>
                      </span>
                      <span class="quick-paths__arrow" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </section>

        <section class="section-grid-wrap" aria-labelledby="sections-title">
          <div class="container">
            <div class="section-intro">
              <h2 id="sections-title">{copy.exploreTitle}</h2>
              <p>{copy.exploreText}</p>
            </div>

            <div class="section-grid section-grid--hierarchical">
              {legacyHomeSections.map(({ section, variant, tone }, index) => (
                <SectionCard
                  href={sectionPath(locale, section)}
                  title={copy.sections[section].title}
                  description={copy.sections[section].description}
                  number={String(index + 1).padStart(2, '0')}
                  variant={variant}
                  tone={tone}
                />
              ))}
            </div>
          </div>
        </section>

        <section class="principles-section" aria-labelledby="principles-title">
          <div class="container principles-layout">
            <div class="principles-heading">
              <p class="eyebrow">{SITE.umbrellaName}</p>
              <h2 id="principles-title">{copy.principlesTitle}</h2>
              <p>{copy.principlesText}</p>
            </div>

            <div class="principles-list">
              {copy.principles.map((principle, index) => (
                <article class="principle-item">
                  <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                  <div>
                    <h3>{principle.title}</h3>
                    <p>{principle.description}</p>
                  </div>
                </article>
              ))}
              <p class="principles-boundary">{copy.principlesBoundary}</p>
            </div>
          </div>
        </section>
      </>
    )
  }
</BaseLayout>
