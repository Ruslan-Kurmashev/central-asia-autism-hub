---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { localePath } from '../../../../lib/urls';
import cards from '../../../../data/autism-glossary-ru.json';
---

<BaseLayout
  title="Словарь терминов | Autism Hub Kazakhstan"
  description="Словарь из 217 терминов об аутизме с понятными объяснениями, тематическими категориями, поиском и источниками."
  locale="ru"
  currentSection="parents"
  alternatePath="parents"
  alternatePaths={{ ru: 'parents/glossary' }}
>
  <div class="glossary-root wrap" id="content">

<section id="catalog" aria-label="Список терминов">
<nav class="breadcrumb" aria-label="Путь к справочнику"><a href={localePath("ru", "parents")}>Родителям</a><i aria-hidden="true">/</i><span aria-current="page">Словарь терминов</span></nav>
<div class="hero"><p class="eyebrow">Понятно о важном</p><h1>Словарь терминов</h1><p class="lede">Объяснения слов, которые родители встречают в заключениях, на консультациях и в программах поддержки.</p></div>
<div class="filters" aria-label="Поиск и фильтры">
<div class="field"><label class="field-label" for="search">Поиск по терминам</label><div class="search-wrap"><svg class="search-icon" aria-hidden="true" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10.5" cy="10.5" r="7"/><path d="m16 16 5 5"/></svg><input class="search-input" id="search" type="search" autocomplete="off" placeholder="Найти термин..."><button type="button" class="search-clear" id="clear" aria-label="Очистить поиск" hidden>×</button></div></div>
<div class="field"><span class="field-label" id="topic-label">Тема</span><div class="topic-picker"><details id="topic-menu"><summary aria-labelledby="topic-label topic-current"><span class="color-dot" id="topic-dot" aria-hidden="true"></span><span class="summary-label" id="topic-current">Все темы</span><svg class="chevron" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary><div id="topic-options" class="topic-popover" aria-label="Выбор темы"></div></details></div></div>
<div class="field field--sort"><label class="field-label" for="sort">Порядок</label><select id="sort"><option value="mixed">Разные темы</option><option value="popular">Как в реестре</option><option value="az">По алфавиту</option></select></div>
</div>
<div class="catalog-heading"><h2 id="results-heading">Все термины</h2><span class="results-count" id="counter" aria-live="polite">217 терминов</span></div>
<div id="cards" class="cards" aria-label="Карточки терминов"></div>
<div class="empty" id="empty" hidden><h3>Ничего не найдено</h3><p>Попробуйте другое слово или выберите другую тему.</p></div>
<div class="show-more-wrap" id="more-wrap"><button type="button" id="more" class="show-more">Показать ещё</button><span id="more-note" class="show-more-caption"></span></div>
<p class="footer-note">Автор и редактор: Руслан Курмашев. Независимая внешняя экспертиза не проводилась. Материалы основаны на указанных источниках и носят справочный характер. Они не заменяют медицинскую диагностику и индивидуальную консультацию. Опубликовано 12 октября 2026 года. Казахские и английские переводы находятся в подготовке.</p>
</section>
<section id="detail" hidden aria-label="Описание термина"><div class="detail-shell"><a id="back" class="back-link" href="#catalog"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>К списку терминов</a><article id="article" class="detail-article"></article><p class="related-end">Информация носит справочный характер и не заменяет медицинскую оценку или консультацию квалифицированного специалиста.</p></div></section>

  </div>
  <script type="application/json" id="glossary-data" is:inline set:html={JSON.stringify(cards)} />
  <script is:inline>
(() => {
'use strict';
const entries=JSON.parse(document.getElementById('glossary-data').textContent);
const byId=new Map(entries.map(x=>[x.id,x]));
const $=id=>document.getElementById(id);
const categoryList=[...new Map(entries.map(x=>[x.category_id,x.category])).entries()].sort((a,b)=>a[0].localeCompare(b[0]));
const state={query:'',category:'',sort:'mixed',limit:12,oldScroll:0};
const collator=new Intl.Collator('ru',{sensitivity:'base'});
const norm=s=>String(s||'').normalize('NFKC').toLocaleLowerCase('ru').replace(/ё/g,'е').trim();
const el=(tag,content,cls)=>{const node=document.createElement(tag);if(cls)node.className=cls;node.textContent=content||'';return node;};
const catLabel=id=>categoryList.find(([a])=>a===id)?.[1]||'Все темы';
const topicList=$('topic-options');
function selectCategory(id){state.category=id;state.limit=12;$('topic-current').textContent=catLabel(id);$('topic-dot').parentElement.dataset.cat=id||'';for(const button of topicList.querySelectorAll('button'))button.setAttribute('aria-pressed',String(button.dataset.category===id));$('topic-menu').open=false;renderCatalog();}
for(const [id,label] of [['','Все темы'],...categoryList]){let button=el('button','', 'topic-option');button.type='button';button.dataset.category=id;button.dataset.cat=id;button.setAttribute('aria-pressed',String(!id));let dot=el('span','', 'color-dot');dot.setAttribute('aria-hidden','true');button.append(dot,el('span',label));button.addEventListener('click',()=>selectCategory(id));topicList.append(button);}
document.addEventListener('pointerdown',event=>{if(!$('topic-menu').contains(event.target))$('topic-menu').open=false;});
$('topic-menu').addEventListener('keydown',event=>{if(event.key==='Escape'){$('topic-menu').open=false;$('topic-menu').querySelector('summary').focus();}});
const cardSearch=x=>norm([x.term_ru,x.term_en,x.search_aliases,x.definition_ru,x.category].join(' '));
for(const c of entries)c._search=cardSearch(c);
function mixedSort(items){const groups=new Map(categoryList.map(([id])=>[id,[]]));for(const item of items)groups.get(item.category_id)?.push(item);const result=[];let unfinished=true;while(unfinished){unfinished=false;for(const list of groups.values())if(list.length){unfinished=true;result.push(list.shift());}}return result;}
function filter(){let found=entries.filter(c=>(!state.category||c.category_id===state.category)&&(!state.query||c._search.includes(norm(state.query))));if(state.sort==='az')found.sort((a,b)=>collator.compare(a.term_ru,b.term_ru));else if(state.sort==='mixed'&&!state.category&&!state.query)found=mixedSort(found);return found;}
const arrow=()=>{const svg=document.createElementNS('http://www.w3.org/2000/svg','svg');svg.setAttribute('viewBox','0 0 24 24');svg.setAttribute('width','20');svg.setAttribute('height','20');svg.setAttribute('fill','none');svg.setAttribute('stroke','currentColor');svg.setAttribute('stroke-width','2');svg.setAttribute('aria-hidden','true');const path=document.createElementNS(svg.namespaceURI,'path');path.setAttribute('d','M5 12h14m-6-6 6 6-6 6');svg.append(path);return svg;};
const termCount=n=>n+' '+(n%10===1&&n%100!==11?'термин':n%10>=2&&n%10<=4&&(n%100<12||n%100>14)?'термина':'терминов');
function renderCatalog(){const found=filter();const shown=found.slice(0,state.limit);const frag=document.createDocumentFragment();for(const c of shown){const card=document.createElement('a');card.className='term-card';card.dataset.cat=c.category_id;card.href=['#term',encodeURIComponent(c.id)].join('=');const cat=el('span',c.category,'term-category');card.append(cat,el('h3',c.term_ru),el('p',c.term_en,'term-en'),el('p',c.definition_ru,'term-preview'));const cta=el('span','Читать объяснение','term-cta');cta.append(arrow());card.append(cta);frag.append(card);}$('cards').replaceChildren(frag);$('counter').textContent=termCount(found.length);$('results-heading').textContent=state.query?'Результаты поиска':state.category?catLabel(state.category):'Все термины';$('more-wrap').hidden=shown.length>=found.length;$('more-note').textContent='Показано '+shown.length+' из '+found.length;$('more').textContent='Показать ещё '+Math.min(12,found.length-shown.length);$('empty').hidden=found.length!==0;$('clear').hidden=!state.query;}
function addSection(article,title,value,example=false){if(!value)return;const sec=el('section','','article-section');sec.append(el('h2',title));if(example){const wrap=el('div','','example');wrap.append(el('p',value));sec.append(wrap);}else sec.append(el('p',value));article.append(sec);}
function showTerm(c){const article=$('article');article.dataset.cat=c.category_id;article.replaceChildren(el('div',c.category,'article-category'),el('h1',c.term_ru),el('p',c.term_en,'article-en'),el('p',c.definition_ru,'article-definition'));
addSection(article,'Где можно встретить',c.where_encountered_ru);addSection(article,'Пример',c.example_ru,true);addSection(article,'С чем не путать',c.dont_confuse_ru);addSection(article,'Что полезно знать родителям',c.parent_takeaway_ru);
const linked=(c.related_ids||'').split(';').map(s=>s.trim()).filter(id=>byId.has(id)&&id!==c.id);if(linked.length){const sec=el('section','','article-section');sec.append(el('h2','Связанные понятия'));const ul=el('ul','','related-links');for(const id of linked){const li=el('li','');const a=el('a',byId.get(id).term_ru);a.href=['#term',id].join('=');li.append(a);ul.append(li);}sec.append(ul);article.append(sec);}
const urls=[...new Set((c.source_urls||'').split(';').map(s=>s.trim()).filter(s=>/^https:\/\//i.test(s)))];if(urls.length){const sec=el('section','','article-section sources');sec.append(el('h2','Источники'));const details=el('details','');details.append(el('summary','Показать источники ('+urls.length+')'));const ol=el('ol','','source-links');for(const url of urls){const li=el('li','');const a=el('a',url);a.href=url;a.target='_blank';a.rel='noopener noreferrer';li.append(a);ol.append(li);}details.append(ol);sec.append(details,el('p','Внешние материалы могут быть на английском языке.','article-note'));article.append(sec);}document.title=c.term_ru+' | Словарь AutismHub';}
function handleHash(){const decoded=decodeURIComponent(window.location.hash);const match=/^#term=(AHG-\d{3})$/.exec(decoded);const item=match&&byId.get(match[1]);if(item){if(!$('catalog').hidden)state.oldScroll=window.scrollY;$('catalog').hidden=true;$('detail').hidden=false;showTerm(item);window.scrollTo({top:0,behavior:'instant'});}else{$('detail').hidden=true;$('catalog').hidden=false;document.title='Словарь терминов | Autism Hub Kazakhstan';renderCatalog();if(state.oldScroll>0)window.scrollTo({top:state.oldScroll,behavior:'instant'});}}
$('search').addEventListener('input',e=>{state.query=e.target.value;state.limit=12;renderCatalog();});$('clear').addEventListener('click',()=>{$('search').value='';state.query='';state.limit=12;renderCatalog();$('search').focus();});$('sort').addEventListener('change',e=>{state.sort=e.target.value;state.limit=12;renderCatalog();});$('more').addEventListener('click',()=>{state.limit+=12;renderCatalog();});window.addEventListener('hashchange',handleHash);renderCatalog();handleHash();
})();

  </script>
</BaseLayout>

<style is:global>

.glossary-root{--bg:#f5f8fb;--white:#fff;--ink:#172b46;--muted:#576c82;--blue:#205da8;--teal:#176b72;--line:#dbe5ee;--focus:#b74e21;--shadow:0 5px 19px rgb(35 70 110 / 4%);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color-scheme:light}
*{box-sizing:border-box}
.glossary-root{scroll-behavior:smooth}
.glossary-root{margin:0;color:var(--ink);background:var(--bg);font-size:16px;line-height:1.55}
.glossary-root button,.glossary-root input,.glossary-root select{font:inherit}
.glossary-root button{cursor:pointer}
.glossary-root a{color:var(--blue)}
.glossary-root :focus-visible{outline:3px solid var(--focus);outline-offset:3px}
[hidden]{display:none!important}
.glossary-internal-skip{position:absolute;top:-90px;left:12px;z-index:70;padding:10px 16px;background:var(--white);border:1px solid var(--line);border-radius:8px}
.glossary-internal-skip:focus{top:12px}
.sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.wrap{max-width:1460px;margin-inline:auto;padding-inline:clamp(17px,3vw,42px)}
.glossary-internal-header{border-bottom:1px solid #e3eaf3;background:#fff}
.glossary-internal-header-inner{min-height:74px;display:flex;gap:18px;align-items:center;justify-content:space-between}
.glossary-internal-brand{display:inline-flex;gap:11px;align-items:center;text-decoration:none;color:var(--ink)}
.glossary-internal-brand-mark{width:42px;height:42px;display:grid;place-items:center;background:linear-gradient(140deg,#e1eefb,#e7f7f1);border-radius:13px;font-size:16px;font-weight:850;color:#236e9d}
.glossary-internal-brand-name{display:block;font-weight:800;font-size:17px;line-height:1.2}
.glossary-internal-brand-context{display:block;color:#6d7e91;font-size:12px;margin-top:3px}
.glossary-internal-header-status{color:#6c7d91;font-size:13px}
.glossary-root{padding-bottom:80px}
.breadcrumb{display:flex;gap:9px;flex-wrap:wrap;font-size:13px;margin-block:23px 24px;color:#738399}
.breadcrumb i{font-style:normal;color:#a9b3c2}
.hero{max-width:950px;margin-bottom:27px}
.hero .eyebrow{margin:0 0 11px;color:#18717a;font-size:12px;font-weight:800;letter-spacing:.09em;text-transform:uppercase}
.glossary-root h1,.glossary-root h2,.glossary-root h3{line-height:1.22;letter-spacing:-.028em}
.hero h1{margin:0;font-size:clamp(32px,3vw,46px);font-weight:820}
.hero .lede{max-width:860px;font-size:clamp(16px,1.5vw,18px);color:#526981;line-height:1.6;margin:12px 0 0}
.filters{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(310px,.95fr) minmax(174px,.45fr);align-items:end;gap:17px;background:#fff;border:1px solid var(--line);border-radius:19px;padding:20px 23px;box-shadow:var(--shadow)}
.field{min-width:0;display:grid;gap:7px}
.field-label{font-size:13px;font-weight:760;color:#375371}
.search-wrap{position:relative;display:block}
.search-wrap .search-icon{position:absolute;left:17px;top:50%;transform:translateY(-50%);color:#8195ab;pointer-events:none}
.search-input{width:100%;min-width:0;border:1px solid #cad9e8;border-radius:11px;height:51px;padding:0 49px 0 48px;background:#fbfdff;font-size:15px;color:var(--ink)}
.search-input::placeholder{color:#71849c}
.search-input:focus{border-color:#6b9ecd;background:#fff}
.search-clear{position:absolute;top:5px;right:5px;width:42px;height:41px;border:0;border-radius:9px;background:transparent;color:#657b94;font-size:24px}
.search-clear:hover{background:#edf4fa}
.glossary-root select{height:51px;width:100%;border:1px solid #cad9e8;border-radius:11px;background:white;color:var(--ink);padding:0 12px;font-size:14px}
.topic-picker{position:relative;min-width:0}
.topic-picker details{position:relative}
.topic-picker summary{height:51px;display:flex;align-items:center;gap:12px;background:#fff;border:1px solid #cad9e8;border-radius:11px;padding:0 15px;cursor:pointer;list-style:none;user-select:none;font-size:14px}
.topic-picker summary::-webkit-details-marker{display:none}
.topic-picker details[open] summary{border-color:#80afd5;box-shadow:0 0 0 3px #e8f2fc;border-radius:11px 11px 0 0}
.summary-label{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#203a57}
.chevron{flex:none;width:18px;height:18px;color:#5b708a;transition:transform .16s}
.topic-picker details[open] .chevron{transform:rotate(180deg)}
.topic-popover{position:absolute;top:calc(100% - 1px);left:0;right:0;z-index:30;background:#fff;border:1px solid #9cbfdb;border-top:0;border-radius:0 0 13px 13px;box-shadow:0 20px 32px rgb(28 53 80 / 15%);max-height:min(460px,65vh);overflow:auto;padding:7px}
.topic-option{width:100%;display:flex;gap:11px;align-items:center;min-height:38px;border:0;border-radius:8px;text-align:left;background:transparent;color:#263e5a;padding:9px 11px;font-size:13.2px;line-height:1.37}
.topic-option:hover,.topic-option:focus-visible{background:var(--cat-bg,#eff5fc)}
.topic-option[aria-pressed=true]{background:var(--cat-bg,#eaf2fb);color:var(--cat-fg,#1b63a7);font-weight:760}
.color-dot{display:inline-block;flex:none;width:12px;height:12px;border-radius:100%;background:var(--cat-line,#96a8bd);box-shadow:inset 0 0 0 1px #0000000c}
.catalog-heading{display:flex;justify-content:space-between;gap:15px;align-items:baseline;margin:30px 0 16px}
.catalog-heading h2{font-weight:790;font-size:23px;margin:0}
.results-count{color:var(--muted);font-size:14px;white-space:nowrap}
.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px}
.term-card{--cat-bg:#e8f1fb;--cat-fg:#205b9b;--cat-line:#80b7e8;display:flex;flex-direction:column;min-width:0;min-height:284px;padding:23px 25px 21px;background:white;border:1px solid var(--line);border-top:4px solid var(--cat-line);border-radius:15px;color:var(--ink);text-decoration:none;box-shadow:var(--shadow);transition:border-color .16s,box-shadow .16s,transform .16s}
.term-card:hover,.term-card:focus-visible{color:var(--ink);border-color:var(--cat-line);border-top-color:var(--cat-line);box-shadow:0 10px 28px rgb(37 76 118 / 11%);transform:translateY(-2px)}
.term-category{font-size:11.5px;display:inline-flex;align-items:center;gap:6px;align-self:flex-start;max-width:100%;background:var(--cat-bg);color:var(--cat-fg);padding:6px 11px;border-radius:9px;font-weight:760;line-height:1.35;overflow-wrap:anywhere}
.term-card h3{font-size:clamp(19px,1.6vw,23px);font-weight:790;line-height:1.27;overflow-wrap:anywhere;margin:15px 0 4px}
.term-en{font-size:13px;color:#6a7b90;line-height:1.4;margin:0 0 13px;overflow-wrap:anywhere;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}
.term-preview{font-size:15px;color:#455b74;line-height:1.65;margin:0 0 18px;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}
.term-cta{display:flex;align-items:center;justify-content:space-between;gap:9px;margin-top:auto;color:#175ba9;font-size:14px;font-weight:760}
.term-cta svg{flex:none}
[data-cat="01"]{--cat-bg:#e6f2ff;--cat-fg:#185ca2;--cat-line:#72b9f6}
[data-cat="02"]{--cat-bg:#fff0f5;--cat-fg:#9f3b60;--cat-line:#ee9db8}
[data-cat="03"]{--cat-bg:#fff0e4;--cat-fg:#945019;--cat-line:#ffb17c}
[data-cat="04"]{--cat-bg:#fff5d9;--cat-fg:#806010;--cat-line:#eec45f}
[data-cat="05"]{--cat-bg:#e5f6eb;--cat-fg:#1d7044;--cat-line:#81d894}
[data-cat="06"]{--cat-bg:#f0ebff;--cat-fg:#6747a8;--cat-line:#af94f5}
[data-cat="07"]{--cat-bg:#e3f6f4;--cat-fg:#166d73;--cat-line:#75c9c9}
[data-cat="08"]{--cat-bg:#e7f1ff;--cat-fg:#326aa0;--cat-line:#9ac2ee}
[data-cat="09"]{--cat-bg:#f1edfa;--cat-fg:#694b95;--cat-line:#bb9aea}
[data-cat="10"]{--cat-bg:#fff0eb;--cat-fg:#a84d46;--cat-line:#f19c96}
[data-cat="11"]{--cat-bg:#eef1f6;--cat-fg:#45576d;--cat-line:#a7b2c3}
.show-more-wrap{display:grid;justify-items:center;gap:8px;padding:27px 10px 14px}
.show-more{padding:11px 24px;border:1px solid #b5cada;color:#145b9d;background:white;border-radius:10px;min-height:46px;font-weight:730}
.show-more:hover{background:#eef5fd;border-color:#83acd0}
.show-more-caption{color:var(--muted);font-size:12px}
.empty{background:white;border:1px dashed #afc9df;border-radius:15px;padding:40px 22px;text-align:center}
.empty h3{margin:0 0 8px}.empty p{margin:0;color:var(--muted)}
.footer-note{margin-top:48px;max-width:830px;border-top:1px solid var(--line);padding-top:21px;color:#65788d;font-size:13px;line-height:1.65}
/* Reading view */
.detail-shell{max-width:900px;margin-inline:auto}
.back-link{display:inline-flex;align-items:center;gap:8px;border:0;color:#175ba9;padding:8px 0;margin-bottom:16px;text-decoration:none;font-size:14px;font-weight:730}
.back-link:hover{text-decoration:underline}
.detail-article{background:#fff;border:1px solid var(--line);border-top:4px solid var(--cat-line,#8ebcde);border-radius:19px;padding:clamp(23px,5vw,58px);box-shadow:var(--shadow)}
.article-category{display:inline-flex;max-width:100%;background:var(--cat-bg);color:var(--cat-fg);padding:6px 11px;border-radius:8px;font-size:12px;font-weight:730;margin-bottom:19px}
.detail-article h1{font-size:clamp(30px,3vw,44px);margin:0;overflow-wrap:anywhere}
.article-en{font-size:15px;color:#667b90;line-height:1.45;margin:8px 0 25px}
.article-definition{font-size:clamp(17px,1.65vw,19px);line-height:1.82;color:#243b55;margin:0}
.article-section{margin-top:31px;padding-top:24px;border-top:1px solid #e5ecf2}
.article-section h2{font-size:19px;font-weight:750;margin:0 0 11px}
.article-section p{font-size:16px;line-height:1.82;color:#3c536a;margin:0}
.example{background:#f1f7fc;border-radius:11px;padding:17px 20px;border-left:3px solid var(--cat-line)}
.related-links{display:flex;gap:9px;flex-wrap:wrap;list-style:none;padding:0;margin:0}
.related-links a{display:inline-flex;color:#195d99;text-decoration:none;background:#f6faff;border:1px solid #d6e4f1;border-radius:10px;padding:8px 12px;font-size:14px;font-weight:650}
