---
import type { CollectionEntry } from 'astro:content';
import DevelopmentMilestoneAgeSelector from '../components/DevelopmentMilestoneAgeSelector.astro';
import { kazakhstanDocumentGroups } from '../data/kazakhstan-professional-documents';
import { internationalGuidelineCountries } from '../data/international-professional-guidelines';
import { CONTENT_UI, DATE_LOCALES } from '../i18n/content';
import { UI } from '../i18n/ui';
import { articlePath, localePath, sectionPath } from '../lib/urls';
import { selectArticleSections } from '../lib/article-outline.mjs';
import { SITE, type Locale } from '../site.config';
import '../styles/article-v2.css';
import BaseLayout from './BaseLayout.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<'pages'> | CollectionEntry<'research'>;
  alternatePaths: Partial<Record<Locale, string>>;
  headings?: Heading[];
  nextEntry?: CollectionEntry<'pages'> | CollectionEntry<'research'>;
  firstPublishedAt: Date;
}

const { entry, alternatePaths, headings = [], nextEntry, firstPublishedAt } = Astro.props;
const data = entry.data;
const researchDetails = entry.collection === 'research' ? entry.data : null;
const locale = data.language;
const copy = CONTENT_UI[locale];
const sectionCopy = UI[locale].sections[data.section];
// Restore the full three-level document route on all 25 Kazakhstan professional
// reviews. The category is looked up by translationKey rather than by slug so
// reviewed translations can retain the same navigational hierarchy later.
const kazakhstanGroup = data.section === 'professionals'
  ? kazakhstanDocumentGroups.find(group =>
      group.documents.some(document => document.translationKey === data.translationKey))
  : undefined;
const kazakhstanHubPath = kazakhstanGroup ? localePath(locale, 'professionals/kazakhstan-documents') : undefined;
const kazakhstanGroupPath = kazakhstanGroup
  ? localePath(locale, 'professionals/kazakhstan-documents/' + kazakhstanGroup.id)
  : undefined;
const kazakhstanHubTitle = locale === 'ru' ? 'Документы Казахстана' : locale === 'kk' ? 'Қазақстан құжаттары' : 'Kazakhstan documents';
const internationalGuidelineCountry = data.section === 'professionals'
  ? internationalGuidelineCountries.find(country =>
      country.documents.some(document => document.translationKey === data.translationKey))
  : undefined;
const internationalCountryPath = internationalGuidelineCountry
  ? localePath(locale, 'professionals/international-guidelines/' + internationalGuidelineCountry.id)
  : undefined;
const internationalGuidelineLabel = locale === 'ru'
  ? 'Международные клинические руководства'
  : locale === 'kk'
    ? 'Халықаралық клиникалық нұсқаулықтар'
    : 'International clinical guidelines';
const dateFormatter = new Intl.DateTimeFormat(DATE_LOCALES[locale], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const boundaryTitle =
  data.disclaimerType === 'medical'
    ? copy.medicalBoundaryTitle
    : copy.informationBoundaryTitle;
const boundaryText =
  data.disclaimerType === 'medical'
    ? copy.medicalBoundaryText
    : copy.informationBoundaryText;
const isDevelopmentMilestones =
  data.translationKey === 'parents-development-milestones' &&
  data.section === 'parents';
const useArticleV2 = ['ru', 'en', 'kk'].includes(locale);
const articleV2Text = locale === 'en'
  ? {
      toc: 'On this page',
      tocEmpty: 'Article sections will appear here automatically.',
      important: 'Important',
      next: 'Next resource in this topic',
    }
  : locale === 'kk'
    ? {
        toc: 'Мақала мазмұны',
        tocEmpty: 'Мақаланың бөлімдері осында автоматты түрде көрсетіледі.',
        important: 'Маңызды',
        next: 'Тақырып бойынша келесі материал',
      }
    : {
      toc: 'Содержание',
      tocEmpty: 'Разделы статьи появятся здесь автоматически.',
      important: 'Важно',
      next: 'Следующий материал по теме',
    };
// Count main H2 chapters only. H3 subheadings always stay in the article body.
// Where main chapters are explicitly numbered, unnumbered conclusions and
// ancillary H2 blocks should not inflate the section total.
const isHomePreschoolContext = data.translationKey === 'parents-child-context-dependent-behaviour-home-preschool';
const tocHeadings = selectArticleSections(headings);
// All articles show their first publication date, shared across translations.
// updatedAt remains in content metadata for editorial history only.
const displayDate = firstPublishedAt;
const displayDateLabel = copy.publishedLabel;
const researchLabel: Record<Locale, string> = {
  ru: 'Разбор научного исследования',
  kk: 'Ғылыми зерттеуді түсіндіру',
  en: 'Research explained',
};

---

<BaseLayout
  title={`${data.title} - ${SITE.name}`}
  description={data.description}
  locale={locale}
  currentSection={data.section}
  alternatePath={data.section}
  alternatePaths={alternatePaths}
  bodyClass={useArticleV2 ? (data.section === 'parents' ? (data.translationKey === 'parents-autism-neurodiversity-language' ? 'article-v2 parents-article-body neurodiversity-article-body' : isHomePreschoolContext ? 'article-v2 parents-article-body context-home-preschool-article-body' : 'article-v2 parents-article-body') : data.section === 'research' ? 'article-v2 research-article-body' : data.section === 'help-kazakhstan' ? 'article-v2 kz-help-article-body' : kazakhstanGroup ? 'article-v2 professionals-article-body kz-professionals-document-body' : data.section === 'professionals' ? 'article-v2 professionals-article-body' : 'article-v2') : undefined}
>
  {
    useArticleV2 ? (
      <article class="article-v2__page">
        <header
          class:list={[
            'article-v2__header',
            data.featuredImage && 'article-v2__header--image',
          ]}
        >
          <div class="container article-v2__header-inner">
            <div class="article-v2__header-intro">
              <p class="article-v2__breadcrumb">
                <a href={localePath(locale)}>{UI[locale].homeLabel}</a>
                <span aria-hidden="true"> / </span>
                <a href={sectionPath(locale, data.section)}>{sectionCopy.title}</a>
                {kazakhstanGroup && (
                  <>
                    <span aria-hidden="true"> / </span>
                    <a href={kazakhstanHubPath}>{kazakhstanHubTitle}</a>
                    <span aria-hidden="true"> / </span>
                    <a href={kazakhstanGroupPath}>{kazakhstanGroup.title[locale]}</a>
                  </>
                )}
                {internationalGuidelineCountry && (
                  <>
                    <span aria-hidden="true"> / </span>
                    <a href={sectionPath(locale, 'professionals') + '#professional-guidelines'}>{internationalGuidelineLabel}</a>
                    <span aria-hidden="true"> / </span>
                    <a href={internationalCountryPath}>{internationalGuidelineCountry.title[locale]}</a>
                  </>
                )}
                <span class="article-v2__breadcrumb-current-separator" aria-hidden="true"> / </span>
                <span class="article-v2__breadcrumb-current" aria-current="page">{data.title}</span>
              </p>

              <p class="article-v2__eyebrow">
                {researchDetails ? researchLabel[locale] : copy.articleLabel}
              </p>
              <h1>{data.title}</h1>
            </div>

            {data.featuredImage && (
              <figure class:list={['article-v2__hero-art', researchDetails?.featuredImageCredit && 'article-v2__hero-art--source']}>
                {researchDetails?.featuredImageSourceUrl ? (
                  <a
                    class="article-v2__hero-original"
                    href={researchDetails.featuredImageSourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={researchDetails.featuredImageSourceUrl.includes('commons.wikimedia.org')
                      ? (locale === 'ru' ? 'Открыть страницу источника иллюстрации' : locale === 'kk' ? 'Иллюстрация дереккөзінің бетін ашу' : 'Open the illustration source page')
                      : (locale === 'ru' ? 'Открыть оригинальный рисунок исследования' : locale === 'kk' ? 'Зерттеудің бастапқы суретін ашу' : 'Open the original research figure')}
                  >
                    <img
                      src={data.featuredImage}
                      alt={data.featuredImageAlt ?? ''}
                      loading="eager"
                      fetchpriority="high"
                      decoding="async"
                    />
                  </a>
                ) : (
                  <img
                    src={data.featuredImage}
                    alt={data.featuredImageAlt ?? ''}
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                  />
                )}
                {researchDetails?.featuredImageCredit && (
                  <figcaption class="article-v2__hero-credit">
                    {researchDetails.featuredImageCredit}
                    {researchDetails.featuredImageLicenseUrl && (
                      <>
                        {' '}
                        <a href={researchDetails.featuredImageLicenseUrl} rel="external">
                          {researchDetails.featuredImageLicenseUrl.includes('/publicdomain/')
                            ? 'Public Domain'
                            : researchDetails.featuredImageLicenseUrl.includes('/licenses/by/4.0/')
                              ? 'CC BY 4.0'
                              : researchDetails.featuredImageLicenseUrl.includes('/licenses/by-sa/3.0/')
                                ? 'CC BY-SA 3.0'
                                : researchDetails.featuredImageLicenseUrl.includes('/licenses/by-sa/4.0/')
                                  ? 'CC BY-SA 4.0'
                                  : 'Лицензия изображения'}
                        </a>.
                      </>
                    )}
                  </figcaption>
                )}
              </figure>
            )}

            <div class="article-v2__header-details">
              <p class="article-v2__summary">{data.summary}</p>
              <dl class="article-v2__meta">
                {displayDate && (
                  <div>
                    <dt>{displayDateLabel}</dt>
                    <dd>
                      <time datetime={displayDate.toISOString()}>
                        {dateFormatter.format(displayDate)}
                      </time>
                    </dd>
                  </div>
                )}
                {data.author === data.editor ? (
                  <div>
                    <dt>{copy.authorAndEditorLabel}</dt>
                    <dd>{data.author}</dd>
                  </div>
                ) : (
                  <>
                    <div>
                      <dt>{copy.authorLabel}</dt>
                      <dd>{data.author}</dd>
                    </div>
                    <div>
                      <dt>{copy.editorLabel}</dt>
                      <dd>{data.editor}</dd>
                    </div>
                  </>
                )}
              </dl>


            </div>
          </div>
        </header>

        <div class="container article-v2__layout">
          <aside class="article-v2__sidebar" aria-label={articleV2Text.toc}>
            <details class="article-v2__toc" open>
              <summary class="article-v2__toc-title">
                <span>{articleV2Text.toc}</span>
                {tocHeadings.length > 0 && (
                  <span class="article-v2__toc-progress" aria-hidden="true">
                    <span data-toc-current>01</span> / {String(tocHeadings.length).padStart(2, '0')}
                  </span>
                )}
              </summary>
              <div class="article-v2__toc-panel">
                {tocHeadings.length > 0 ? (
                  <nav aria-label={articleV2Text.toc}>
                    <ol>
                      {tocHeadings.map((heading) => (
                        <li class:list={[heading.depth === 3 && 'article-v2__toc-subitem']}>
                          <a href={`#${heading.slug}`}>{heading.text}</a>
                        </li>
                      ))}
                    </ol>
                  </nav>
                ) : (
                  <p class="article-v2__toc-empty">{articleV2Text.tocEmpty}</p>
                )}

                <div class="article-v2__toc-boundary">
                  <strong>{boundaryTitle}</strong>
                  <span>{boundaryText}</span>
                </div>
              </div>
            </details>
          </aside>

          <div class="article-v2__main">
            {isDevelopmentMilestones && (
              <DevelopmentMilestoneAgeSelector
                locale={locale}
                parentSlug={data.slug}
              />
            )}

            {data.keyPoints.length > 0 && (
              <section class="article-v2__key-points" aria-labelledby="key-points-title">
                <p class="article-v2__block-label">01</p>
                <div>
                  <h2 id="key-points-title">{copy.keyPointsTitle}</h2>
                  <ul>
                    {data.keyPoints.map((point) => <li>{point}</li>)}
                  </ul>
                </div>
              </section>
            )}

            <div class="article-v2__body article-body">
              <slot />
            </div>

            {data.evidenceLimitations && (
              <section
                class="article-v2__limitations"
                aria-labelledby="limitations-title"
              >
                <p class="article-v2__block-label">{articleV2Text.important}</p>
                <div>
                  <h2 id="limitations-title">{copy.limitationsTitle}</h2>
                  <p>{data.evidenceLimitations}</p>
                </div>
              </section>
            )}

            {!researchDetails && (
            <section class="article-v2__sources" aria-labelledby="sources-title">
              <div class="article-v2__sources-heading">
                <p class="article-v2__eyebrow">{locale === 'ru' ? 'Библиография' : locale === 'kk' ? 'Пайдаланылған әдебиеттер' : 'References'}</p>
                <h2 id="sources-title">{copy.sourcesTitle}</h2>
              </div>

              <ol>
                {data.sources.map((source, index) => (
                  <li>
                    <span class="article-v2__source-number">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <div>
                      <a href={source.url} rel="external">{source.title}</a>
                      <p>
                        {source.organisation && <span>{source.organisation}</span>}
                        {source.publicationYear && <span> · {source.publicationYear}</span>}
                      </p>
                    </div>
                  </li>
                ))}
              </ol>
            </section>

            )}

            {data.versionNote && (
              <aside class="article-v2__version">
                <h2>{copy.versionLabel}</h2>
                <p>{data.versionNote}</p>
              </aside>
            )}

            <footer class="article-v2__footer">
              <a class="article-v2__back" href={kazakhstanGroup ? kazakhstanGroupPath : internationalGuidelineCountry ? internationalCountryPath : sectionPath(locale, data.section)}>
                {kazakhstanGroup
                  ? <>← {kazakhstanGroup.title[locale]}</>
                  : internationalGuidelineCountry
                    ? <>← {internationalGuidelineCountry.title[locale]}</>
                    : <>← {copy.backToSection}: {sectionCopy.title}</>}
              </a>

              {nextEntry && (
                <a
                  class="article-v2__next"
                  href={articlePath(locale, nextEntry.data.section, nextEntry.data.slug)}
                >
                  <span>{articleV2Text.next}</span>
                  <strong>{nextEntry.data.title}</strong>
                  <span aria-hidden="true">→</span>
                </a>
              )}
            </footer>
          </div>
        </div>
      </article>
    ) : (
      <article class="article-page">
        <header class="article-header">
          <div class="container article-shell">
            <p class="breadcrumb">
              <a href={localePath(locale)}>{UI[locale].homeLabel}</a>
              <span aria-hidden="true"> / </span>
              <a href={sectionPath(locale, data.section)}>{sectionCopy.title}</a>
              <span aria-hidden="true"> / </span>
              <span aria-current="page">{data.title}</span>
            </p>
            <p class="eyebrow">{researchDetails ? researchLabel[locale] : copy.articleLabel}</p>
            <h1>{data.title}</h1>
            {data.featuredImage && (
              <figure class="article-header__media">
                <img
                  src={data.featuredImage}
                  alt={data.featuredImageAlt ?? ''}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              </figure>
            )}
            <p class="article-header__summary">{data.summary}</p>

            <dl class="article-meta">
              {displayDate && (
                <div>
                  <dt>{displayDateLabel}</dt>
                  <dd><time datetime={displayDate.toISOString()}>{dateFormatter.format(displayDate)}</time></dd>
                </div>
              )}
            </dl>
          </div>
        </header>

        <div class="container article-shell article-content">
          {isDevelopmentMilestones && (
            <DevelopmentMilestoneAgeSelector
              locale={locale}
              parentSlug={data.slug}
            />
          )}

          {data.keyPoints.length > 0 && (
            <section class="article-key-points" aria-labelledby="key-points-title">
              <h2 id="key-points-title">{copy.keyPointsTitle}</h2>
              <ul>
                {data.keyPoints.map((point) => <li>{point}</li>)}
              </ul>
            </section>
          )}

          <div class="article-body">
            <slot />
          </div>

          {data.evidenceLimitations && (
            <section class="article-limitations" aria-labelledby="limitations-title">
              <h2 id="limitations-title">{copy.limitationsTitle}</h2>
              <p>{data.evidenceLimitations}</p>
            </section>
          )}

          {!researchDetails && (
          <section class="article-sources" aria-labelledby="sources-title">
            <h2 id="sources-title">{copy.sourcesTitle}</h2>
            <ol>
              {data.sources.map((source) => (
                <li>
                  <a href={source.url} rel="external">{source.title}</a>
                  {source.organisation && <span>. {source.organisation}</span>}
                  {source.publicationYear && <span> ({source.publicationYear})</span>}
                </li>
              ))}
            </ol>
          </section>

          )}

          <aside class="article-notice article-notice--boundary">
            <h2>{boundaryTitle}</h2>
            <p>{boundaryText}</p>
          </aside>

          {data.versionNote && (
            <aside class="article-version-note">
              <h2>{copy.versionLabel}</h2>
              <p>{data.versionNote}</p>
            </aside>
          )}

          <a class="back-link" href={sectionPath(locale, data.section)}>
            ← {copy.backToSection}: {sectionCopy.title}
          </a>
        </div>
      </article>
    )
  }
</BaseLayout>

<script is:inline>
  // Keep navigation on the same article URL: no pagination or hidden chapters.
  // Follow scroll position, not click order, so readers can jump to any section.
  const articleToc = document.querySelector('.article-v2__toc');
  const articlePage = document.querySelector('.article-v2__page');
  const articleSidebar = document.querySelector('.article-v2__sidebar');
  const articleHeader = document.querySelector('.site-header');
  if (articleToc instanceof HTMLDetailsElement && articlePage) {
    const mobileToc = window.matchMedia('(max-width: 58rem)');
    const links = Array.from(articleToc.querySelectorAll('nav a[href^="#"]'))
      .filter((link) => link instanceof HTMLAnchorElement);
    const sections = links.map((link) => ({
      link,
      heading: document.getElementById(decodeURIComponent(link.hash.slice(1))),
    })).filter((item) => item.heading);
    const progress = articleToc.querySelector('[data-toc-current]');
    let scheduled = false;
    let lastActive = -1;

    const updateOffsets = () => {
      const height = articleHeader instanceof HTMLElement
        ? articleHeader.getBoundingClientRect().height : 80;
      const tocHeight = mobileToc.matches
        ? articleToc.querySelector('summary')?.getBoundingClientRect().height ?? 48
        : 0;
      articlePage.style.setProperty('--article-toc-top', (height + 12) + 'px');
      articlePage.style.setProperty('--article-anchor-offset', (height + tocHeight + 18) + 'px');
    };

    const highlight = () => {
      scheduled = false;
      if (!sections.length) return;
      const headerHeight = articleHeader instanceof HTMLElement
        ? articleHeader.getBoundingClientRect().height : 80;
      const tocHeight = mobileToc.matches
        ? (articleToc.querySelector('summary')?.getBoundingClientRect().height ?? 48) : 0;
      // Highlight a section once its heading enters the upper reading area,
      // rather than waiting until it touches the sticky header.
      const threshold = Math.max(
        headerHeight + tocHeight + 32,
        Math.min(window.innerHeight * 0.4, headerHeight + tocHeight + 220),
      );
      let active = 0;
      for (let i = 0; i < sections.length; i++) {
        if (sections[i].heading.getBoundingClientRect().top <= threshold) active = i;
        else break;
      }
      if (active === lastActive) return;
      lastActive = active;
      sections.forEach(({ link }, index) => {
        if (index === active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      if (progress) progress.textContent = String(active + 1).padStart(2, '0');
      if (!mobileToc.matches && articleSidebar instanceof HTMLElement) {
        const rect = sections[active].link.getBoundingClientRect();
        const scrollBox = articleSidebar.getBoundingClientRect();
        if (rect.top < scrollBox.top + 8) articleSidebar.scrollTop -= (scrollBox.top + 8 - rect.top);
        if (rect.bottom > scrollBox.bottom - 8) articleSidebar.scrollTop += (rect.bottom - scrollBox.bottom + 8);
      }
    };

    const queueHighlight = () => {
      if (scheduled) return;
      scheduled = true;
      window.requestAnimationFrame(highlight);
    };
    const syncViewport = () => {
      updateOffsets();
      articleToc.open = !mobileToc.matches;
      lastActive = -1;
      queueHighlight();
    };
    syncViewport();
    mobileToc.addEventListener('change', syncViewport);
    window.addEventListener('scroll', queueHighlight, { passive: true });
    window.addEventListener('hashchange', queueHighlight);
    window.addEventListener('resize', () => { updateOffsets(); queueHighlight(); }, { passive: true });
    if (articleHeader instanceof HTMLElement && 'ResizeObserver' in window) {
      new ResizeObserver(updateOffsets).observe(articleHeader);
    }
    articleToc.addEventListener('click', (event) => {
      const link = event.target instanceof Element
        ? event.target.closest('a[href^="#"]') : null;
      if (!(link instanceof HTMLAnchorElement)) return;
      // Native anchors preserve deep links, the browser's history and keyboard navigation.
      if (mobileToc.matches) {
        window.requestAnimationFrame(() => { articleToc.open = false; });
      }
      queueHighlight();
    });
  }


  // No request to YouTube is made until the visitor activates the player.
  document.querySelectorAll('[data-youtube-video]').forEach((block) => {
    const button = block.querySelector('.article-video-embed__activate');
    const player = block.querySelector('.article-video-embed__player');
    if (!(button instanceof HTMLButtonElement) || !(player instanceof HTMLElement)) return;

    button.addEventListener('click', () => {
      const videoId = block.getAttribute('data-youtube-video');
      if (!videoId || !/^[A-Za-z0-9_-]{11}$/.test(videoId)) return;

      const iframe = document.createElement('iframe');
      iframe.className = 'article-video-embed__iframe';
      iframe.src = 'https://www.youtube-nocookie.com/embed/' + videoId + '?rel=0';
      iframe.title = button.getAttribute('aria-label') || 'Видео YouTube';
      iframe.allow = 'encrypted-media; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      player.replaceChildren(iframe);
      iframe.focus();
    }, { once: true });
  });

  document.querySelectorAll('.article-body table').forEach((table) => {
    const headers = Array.from(table.querySelectorAll('thead th')).map((header) =>
      header.textContent?.trim() ?? '',
    );

    if (headers.length < 2) return;

    table.setAttribute('data-mobile-cards', 'true');

    table.querySelectorAll('tbody tr').forEach((row) => {
      Array.from(row.children).forEach((cell, index) => {
        if (cell instanceof HTMLElement) {
          cell.dataset.label = headers[index] ?? '';
        }
      });
    });

    // The context-comparison guide uses detailed four-column tables. At laptop
    // widths, scroll the complete table instead of breaking Russian words.
    if (document.body.classList.contains('context-home-preschool-article-body')) {
      const wrapper = document.createElement('div');
      wrapper.className = 'context-comparison-table-scroll';
      wrapper.tabIndex = 0;
      wrapper.setAttribute('role', 'region');
      wrapper.setAttribute('aria-label', 'Таблица: прокрутите по горизонтали, чтобы увидеть остальные столбцы');
      table.parentNode?.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    }
  });
</script>

<style is:global>
  .article-page,
  .article-content,
  .article-body,
  .article-v2__page,
  .article-v2__layout,
  .article-v2__main,
  .article-v2__body {
    min-width: 0;
    max-width: 100%;
  }

  .article-page,
  .article-v2__page {
    overflow-x: clip;
  }

  .article-header__media {
    width: 100%;
    max-height: 20rem;
    aspect-ratio: 16 / 9;
    margin: 1.5rem 0;
    overflow: hidden;
    border-radius: var(--radius-medium);
    background: #eef4f3;
  }

  .article-header__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-header__media img[src$='.svg'] {
    object-fit: contain;
  }

  .article-body table {
    width: 100%;
    border-collapse: collapse;
  }

  .article-body th,
  .article-body td {
    vertical-align: top;
  }

